                                                                        Height="22"
                                                                        Padding="6,0"
                                                                        ToolTip="Pivot поиск по этой почте">
                                                                    <TextBlock Text="Pivot" FontSize="9" FontWeight="Bold" Foreground="#00D2FF" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </StackPanel>

