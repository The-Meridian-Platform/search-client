<Window x:Class="MeridianClient.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Палитра цвета"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="380" Height="500">

    <Border x:Name="mainContainerBorder"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="20"
            Opacity="0">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                <TranslateTransform Y="10" />
            </TransformGroup>
        </Border.RenderTransform>
        <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>

        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.22">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                         From="0.94" To="1.0" Duration="0:0:0.25">
                            <DoubleAnimation.EasingFunction>
                                <BackEase Amplitude="0.25" EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                         From="0.94" To="1.0" Duration="0:0:0.25">
                            <DoubleAnimation.EasingFunction>
                                <BackEase Amplitude="0.25" EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                         From="10" To="0" Duration="0:0:0.22">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="6" Opacity="0.55" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Title & Drag Header -->
                <RowDefinition Height="Auto" />
                <!-- 2D Saturation / Value Color Spectrum Canvas -->
                <RowDefinition Height="140" />
                <!-- Hue Slider Spectrum Strip -->
                <RowDefinition Height="Auto" />
                <!-- Quick Palette Swatches -->
                <RowDefinition Height="Auto" />
                <!-- RGB & HEX Live Controls -->
                <RowDefinition Height="Auto" />
                <!-- Action Buttons (Apply / Cancel) -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header (Draggable) -->
            <Grid Grid.Row="0" Margin="0,0,0,14" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown" Background="Transparent" Cursor="SizeAll">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Color24" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="Выбор цвета"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Width="28" Height="28"
                        Padding="0"
                        Click="OnCancelClick"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderBrush="Transparent">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" />
                </Button>
            </Grid>

            <!-- 2. Interactive 2D Color Spectrum Box (Saturation & Value) -->
            <Border Grid.Row="1"
                    CornerRadius="8"
                    ClipToBounds="True"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    Margin="0,0,0,12">
                <Canvas x:Name="spectrumCanvas"
                        MouseDown="OnSpectrumMouseDown"
                        MouseMove="OnSpectrumMouseMove"
                        MouseUp="OnSpectrumMouseUp"
                        Background="Transparent"
                        Cursor="Cross">
                    <!-- Base Hue Color Layer -->
                    <Rectangle x:Name="spectrumBaseRect"
                               Width="{Binding ActualWidth, ElementName=spectrumCanvas}"
                               Height="{Binding ActualHeight, ElementName=spectrumCanvas}" />

                    <!-- Horizontal White Gradient (Saturation 0 -> 1) -->
                    <Rectangle Width="{Binding ActualWidth, ElementName=spectrumCanvas}"
                               Height="{Binding ActualHeight, ElementName=spectrumCanvas}">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Vertical Black Gradient (Value 1 -> 0) -->
                    <Rectangle Width="{Binding ActualWidth, ElementName=spectrumCanvas}"
                               Height="{Binding ActualHeight, ElementName=spectrumCanvas}">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#FF000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Picker Crosshair Ring -->
                    <Ellipse x:Name="pickerCursor"
                             Width="14" Height="14"
                             Stroke="#FFFFFF"
                             StrokeThickness="2"
                             IsHitTestVisible="False">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="0" Opacity="0.9" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Border>

            <!-- 3. Rainbow Hue Slider -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Border Height="14" CornerRadius="7" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFF0000" Offset="0.0" />
                            <GradientStop Color="#FFFFFF00" Offset="0.17" />
                            <GradientStop Color="#FF00FF00" Offset="0.33" />
                            <GradientStop Color="#FF00FFFF" Offset="0.5" />
                            <GradientStop Color="#FF0000FF" Offset="0.67" />
                            <GradientStop Color="#FFFF00FF" Offset="0.83" />
                            <GradientStop Color="#FFFF0000" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Slider x:Name="hueSlider"
                        Minimum="0" Maximum="360"
                        ValueChanged="OnHueSliderValueChanged"
                        Opacity="0.8"
                        VerticalAlignment="Center" />
            </Grid>

            <!-- 4. Quick Curated Swatches with Rich Colors -->
            <StackPanel Grid.Row="3" Margin="0,0,0,14">
                <TextBlock Text="ПОПУЛЯРНЫЕ ОТТЕНКИ:"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,8" />
                <WrapPanel x:Name="swatchesPanel" />
            </StackPanel>

            <!-- 5. Live Color Preview & HEX Input -->
            <Grid Grid.Row="4" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="colorPreviewBorder"
                        Grid.Column="0"
                        Width="36" Height="36"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1.5"
                        HorizontalAlignment="Left" />

                <ui:TextBox x:Name="txtHex"
                            Grid.Column="1"
                            Height="36"
                            VerticalContentAlignment="Center"
                            FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                            FontSize="13"
                            Margin="0,0,8,0"
                            TextChanged="OnHexTextChanged" />

                <!-- RGB values badge -->
                <Border Grid.Column="2"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,4"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="txtRgbLabel"
                               Text="R: 0  G: 0  B: 0"
                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </Border>
            </Grid>

            <!-- 6. Apply / Cancel Action Buttons -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Применить"
                        Height="36"
                        Click="OnOkClick"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="#040914"
                        FontWeight="Bold"
                        Cursor="Hand" />

                <Button Grid.Column="2"
                        Content="Отмена"
                        Height="36"
                        Click="OnCancelClick"
                        Background="Transparent"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Cursor="Hand" />
            </Grid>
        </Grid>
    </Border>
</Window>