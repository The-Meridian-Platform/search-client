                                                        <ui:SymbolIcon Symbol="Warning24" FontSize="13" Foreground="#FF3366" Margin="0,0,6,0" />
                                                        <TextBlock Text="SPOOFING RISK" FontSize="10" FontWeight="Bold" FontFamily="JetBrains Mono" Foreground="#FF3366" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Row 1: Summary -->
