<UserControl x:Class="MeridianClient.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MeridianClient.ViewModels"
             xmlns:m="clr-namespace:MeridianClient.Models"
             xmlns:conv="clr-namespace:MeridianClient.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:HistoryViewModel}"
             d:DesignHeight="720" d:DesignWidth="980">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:StatusToBrushConverter x:Key="StatusToBrush" />
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="NotEmptyToVis" />

        <Style x:Key="CyberGhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ghostBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ghostBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberDeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A181C26" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="delBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="delBorder" Property="Background" Value="#33FF3366" />
                                <Setter TargetName="delBorder" Property="BorderBrush" Value="#FF3366" />
                                <Setter TargetName="delBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF3366" BlurRadius="14" ShadowDepth="0" Opacity="0.6" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,24">
        <Grid.RenderTransform>
            <TranslateTransform Y="0" />
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.25">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.25">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <!-- Top Action Header -->
            <RowDefinition Height="Auto" />
            <!-- Error Banner -->
            <RowDefinition Height="Auto" />
            <!-- Session List -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP ACTION HEADER -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18,16"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource History_Title}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="{DynamicResource History_Subtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,3,0,0" />
                    <Border Background="{DynamicResource SubtleAccentBrush}"
                            BorderBrush="{DynamicResource BorderAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,3"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Left"
                            Visibility="{Binding CurrentInvestigationTitle, Converter={StaticResource NotEmptyToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BranchFork24" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Проект: " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentInvestigationTitle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Filter: Current Investigation vs All -->
                    <Border Background="{DynamicResource AppBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3"
                            Margin="0,0,12,0"
                            Visibility="{Binding CurrentInvestigationTitle, Converter={StaticResource NotEmptyToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Текущий проект"
                                         IsChecked="{Binding FilterByCurrentInvestigation, Mode=TwoWay}"
                                         Padding="10,4"
                                         FontSize="11"
                                         FontWeight="SemiBold"
                                         Cursor="Hand" />
                            <RadioButton Content="Все сессии"
                                         IsChecked="{Binding FilterByCurrentInvestigation, Converter={StaticResource InverseBool}, Mode=TwoWay}"
                                         Padding="10,4"
                                         FontSize="11"
                                         FontWeight="SemiBold"
                                         Cursor="Hand" />
                        </StackPanel>
                    </Border>

                    <ui:ProgressRing Width="20" Height="20"
                                     IsIndeterminate="True"
                                     Margin="0,0,14,0"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

                    <Button Command="{Binding LoadHistoryCommand}"
                            Height="38"
                            Padding="16,0"
                            Style="{StaticResource CyberGhostButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" Margin="0,0,8,0" FontSize="15" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{DynamicResource History_RefreshBtn}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ERROR BANNER -->
        <Border Grid.Row="1"
                Background="#26FF3366"
                BorderBrush="#4DFF3366"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,0,0,16"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVis}}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ErrorCircle24" Foreground="#FF3366" Margin="0,0,10,0" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FECDD3" TextElement.FontFamily="JetBrains Mono, Cascadia Code, Consolas" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- SESSION LIST -->
        <Grid Grid.Row="2">
            <!-- Empty state -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="48"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="History24" FontSize="54" Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.4" Margin="0,0,0,16" />
                    <TextBlock Text="{DynamicResource History_EmptyTitle}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource History_EmptyDesc}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="13"
                               TextAlignment="Center"
                               MaxWidth="420"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Sessions Scrollable List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSessions, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:SearchSessionModel}">
                            <Border BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16"
                                    Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#00D2FF" BlurRadius="16" ShadowDepth="0" Opacity="0.25" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.RenderTransform>
                                    <TranslateTransform Y="0" />
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="10" To="0" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Session Details -->
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <!-- Status dot with Glow -->
                                            <Ellipse Width="9" Height="9"
                                                     Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="#00D2FF" BlurRadius="8" ShadowDepth="0" Opacity="0.8" />
                                                </Ellipse.Effect>
                                            </Ellipse>

                                            <!-- Target -->
                                            <TextBlock Text="{Binding EffectiveTarget}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       TextElement.FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       Margin="0,0,14,0" />

                                            <!-- Status Badge -->
                                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,2"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Status}"
                                                           TextElement.FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </Border>

                                            <!-- Findings count badge with Dynamic Accent -->
                                            <Border Background="{DynamicResource SubtleAccentBrush}"
                                                    BorderBrush="{DynamicResource BorderAccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,2"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontFamily="JetBrains Mono, Cascadia Code, Consolas">
                                                    <TextBlock Text="{DynamicResource History_Card_Findings}" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding TotalFindings}"
                                                               FontWeight="Black"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Session Id & Timestamps (Monospace) -->
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    TextElement.FontFamily="JetBrains Mono, Cascadia Code, Consolas">
                                            <TextBlock Text="ID: " Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding EffectiveId}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" />

                                            <TextBlock Text="{DynamicResource History_Card_Created}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding FormattedCreatedAt}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" />

                                            <TextBlock Text="{DynamicResource History_Card_Finished}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding FormattedFinishedAt}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding FormattedDuration}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Action Button: Open Session (Neon Hover) -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Height="38"
                                            Padding="18,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="openBorder"
                                                        Background="{DynamicResource SubtleAccentBrush}"
                                                        BorderBrush="{DynamicResource BorderAccentBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="openBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Open24" Margin="0,0,8,0" Foreground="{DynamicResource AccentBrush}" FontSize="15" />
                                            <TextBlock Text="{DynamicResource History_OpenSession}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Delete Session Button -->
                                    <Button Height="38" Width="38"
                                            Margin="8,0,0,0"
                                            Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource CyberDeleteButtonStyle}"
                                            ToolTip="Удалить эту сессию из истории">
                                        <ui:SymbolIcon Symbol="Delete24" Foreground="#FF3366" FontSize="15" />
                                    </Button>
                                </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
