<ui:FluentWindow x:Class="MeridianClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MeridianClient.ViewModels"
        xmlns:views="clr-namespace:MeridianClient.Views"
        xmlns:conv="clr-namespace:MeridianClient.Converters"
        mc:Ignorable="d"
        Title="Meridian Search Platform — Cyber OSINT"
        Icon="pack://application:,,,/Assets/app_icon.png"
        WindowBackdropType="None"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Height="900" Width="1280"
        MinHeight="660" MinWidth="1020"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:BooleanToBrushConverter x:Key="BoolToBrush" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringEqualsToBooleanConverter x:Key="StringEqualsToBool" />

        <!-- DataTemplates to connect ViewModels with their Views -->
        <DataTemplate DataType="{x:Type vm:WelcomeViewModel}">
            <views:WelcomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GraphViewModel}">
            <views:GraphView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <!-- Raycast/Linear Navigation RadioButton Style with Smooth Selection State -->
        <Style x:Key="CyberNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="GroupName" Value="MainNavTabsGroup" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center" />
                                <!-- Active Indicator Bar -->
                                <Border x:Name="activeIndicator"
                                        Grid.Column="1"
                                        Width="3"
                                        Height="18"
                                        CornerRadius="2"
                                        Background="{DynamicResource AccentBrush}"
                                        Opacity="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.02" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.02" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                <Setter TargetName="activeIndicator" Property="Opacity" Value="1" />
                                <Setter TargetName="activeIndicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberNavActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="activeIndicator"
                                        Grid.Column="0"
                                        Width="3" Height="16"
                                        CornerRadius="1.5"
                                        Background="#FF5C5C"
                                        Opacity="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1EFF5C5C" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#40FF5C5C" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                <Setter TargetName="activeIndicator" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2EFF5C5C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Custom TitleBar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area with Navigation Sidebar -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TITLE BAR WITH BACKEND STATUS BADGE -->
        <ui:TitleBar Grid.Row="0"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     Background="Transparent">
            <ui:TitleBar.Header>
                <Button Command="{Binding CheckHealthCommand}"
                        Margin="12,0,0,0"
                        Padding="0"
                        Cursor="Hand"
                        ToolTip="Нажмите для мгновенной проверки соединения с бэкендом"
                        VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="topHealthBadge"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Animated Pulsing Health Dot -->
                                    <Grid Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7"
                                                 Fill="{Binding Health.IsHealthy, Converter={StaticResource BoolToBrush}}">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#00E599" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                                            </Ellipse.Effect>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1.0" Duration="0:0:1.0">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <SineEase EasingMode="EaseInOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                    </Grid>

                                    <!-- Status Text (ONLINE 3ms / OFFLINE) -->
                                    <TextBlock Text="{Binding Health.StatusText}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{Binding Health.IsHealthy, Converter={StaticResource BoolToBrush}}"
                                               VerticalAlignment="Center" />

                                    <!-- Separator Dot -->
                                    <TextBlock Text="•" Margin="8,0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.5" VerticalAlignment="Center" />

                                    <!-- Backend URL display -->
                                    <TextBlock Text="{Binding Settings.BackendUrl}"
                                               FontSize="11"
                                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               VerticalAlignment="Center" />

                                    <ui:ProgressRing Width="11" Height="11"
                                                     Margin="8,0,0,0"
                                                     IsIndeterminate="True"
                                                     Visibility="{Binding Health.IsChecking, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="topHealthBadge" Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}" />
                                    <Setter TargetName="topHealthBadge" Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- MAIN LAYOUT: SIDEBAR + VIEW -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="240" />
                <!-- Content View -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR (Linear / Raycast Style) -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="14,18">
                    <Grid.RowDefinitions>
                        <!-- App Branding -->
                        <RowDefinition Height="Auto" />
                        <!-- Navigation Items -->
                        <RowDefinition Height="*" />
                        <!-- Footer / Periodic Health Status -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- BRANDING -->
                    <StackPanel Grid.Row="0" Margin="4,0,0,26">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <!-- Neon Glowing Radar Icon with Breathing Animation -->
                            <Grid Margin="0,0,10,0">
                                <ui:SymbolIcon Symbol="Radar20"
                                               FontSize="22"
                                               Foreground="{DynamicResource AccentBrush}">
                                    <ui:SymbolIcon.Effect>
                                        <DropShadowEffect Color="#00D2FF" BlurRadius="16" ShadowDepth="0" Opacity="0.8" />
                                    </ui:SymbolIcon.Effect>
                                    <ui:SymbolIcon.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.5" To="1.0" Duration="0:0:1.8">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ui:SymbolIcon.Triggers>
                                </ui:SymbolIcon>
                            </Grid>
                            <TextBlock Text="MERIDIAN"
                                       FontSize="18"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Branding_Subtitle}"
                                   FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>

                    <!-- NAVIGATION BUTTONS -->
                    <StackPanel Grid.Row="1">
                        <!-- Welcome / Home Tab Button -->
                        <RadioButton Height="44"
                                     IsChecked="{Binding CurrentTab, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Welcome, Mode=OneWay}"
                                     Command="{Binding NavigateToCommand}"
                                     CommandParameter="Welcome"
                                     Style="{StaticResource CyberNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Home24" Margin="0,0,12,0" FontSize="18" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{DynamicResource Nav_Welcome}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Search Tab Button -->
                        <RadioButton Height="44"
                                     IsChecked="{Binding CurrentTab, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Search, Mode=OneWay}"
                                     Command="{Binding NavigateToCommand}"
                                     CommandParameter="Search"
                                     Style="{StaticResource CyberNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Search24" Margin="0,0,12,0" FontSize="18" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{DynamicResource Nav_Search}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Graph Tab Button -->
                        <RadioButton Height="44"
                                     IsChecked="{Binding CurrentTab, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Graph, Mode=OneWay}"
                                     Command="{Binding NavigateToCommand}"
                                     CommandParameter="Graph"
                                     Style="{StaticResource CyberNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="BranchFork24" Margin="0,0,12,0" FontSize="18" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{DynamicResource Nav_Graph}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- History Tab Button -->
                        <RadioButton Height="44"
                                     IsChecked="{Binding CurrentTab, Converter={StaticResource StringEqualsToBool}, ConverterParameter=History, Mode=OneWay}"
                                     Command="{Binding NavigateToCommand}"
                                     CommandParameter="History"
                                     Style="{StaticResource CyberNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="History24" Margin="0,0,12,0" FontSize="18" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{DynamicResource Nav_History}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Logs Tab Button -->
                        <RadioButton Height="44"
                                     IsChecked="{Binding CurrentTab, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Logs, Mode=OneWay}"
                                     Command="{Binding NavigateToCommand}"
                                     CommandParameter="Logs"
                                     Style="{StaticResource CyberNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentBulletList24" Margin="0,0,12,0" FontSize="18" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{DynamicResource Nav_Logs}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Settings Tab Button -->
                        <RadioButton Height="44"
                                     IsChecked="{Binding CurrentTab, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Settings, Mode=OneWay}"
                                     Command="{Binding NavigateToCommand}"
                                     CommandParameter="Settings"
                                     Style="{StaticResource CyberNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0" FontSize="18" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{DynamicResource Nav_Settings}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <Separator Background="{DynamicResource CardBorderBrush}" Margin="8,8,8,8" />

                        <!-- Exit to Hub Button -->
                        <Button Height="44"
                                Command="{Binding ExitToHubCommand}"
                                Style="{StaticResource CyberNavActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowExit20" Margin="0,0,12,0" FontSize="18" Foreground="#FF5C5C" />
                                <TextBlock Text="{DynamicResource Nav_ExitToHub}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CURRENT ACTIVE VIEW CONTENT (Smooth Fade & Slide) -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentViewModel}">
                <ContentControl.RenderTransform>
                    <TranslateTransform Y="0" />
                </ContentControl.RenderTransform>
                <ContentControl.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1.0" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="8" To="0" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ContentControl.Triggers>
            </ContentControl>

            <views:ToastNotificationControl x:Name="toastControl"
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,32,32"
                                            Panel.ZIndex="9999" />
        </Grid>
    </Grid>
</ui:FluentWindow>
