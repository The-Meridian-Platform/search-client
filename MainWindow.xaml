<ui:FluentWindow x:Class="MeridianClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MeridianClient.ViewModels"
        xmlns:views="clr-namespace:MeridianClient.Views"
        xmlns:conv="clr-namespace:MeridianClient.Converters"
        mc:Ignorable="d"
        Title="Meridian Search Platform — Cyber OSINT"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        Background="Transparent"
        Height="900" Width="1280"
        MinHeight="660" MinWidth="1020"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:BooleanToBrushConverter x:Key="BoolToBrush" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringEqualsToBooleanConverter x:Key="StringEqualsToBool" />

        <!-- DataTemplates to connect ViewModels with their Views -->
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <!-- Raycast/Linear Navigation RadioButton Style with Smooth Selection State -->
        <Style x:Key="CyberNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="GroupName" Value="MainNavTabsGroup" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center" />
                                <!-- Active Indicator Bar -->
                                <Border x:Name="activeIndicator"
                                        Grid.Column="1"
                                        Width="3"
                                        Height="18"
                                        CornerRadius="2"
                                        Background="#00D2FF"
                                        Opacity="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#00D2FF" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1AFFFFFF" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#2AFFFFFF" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.02" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.02" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2600D2FF" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#4D00D2FF" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                                <Setter TargetName="activeIndicator" Property="Opacity" Value="1" />
                                <Setter TargetName="btnBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00D2FF" BlurRadius="14" ShadowDepth="0" Opacity="0.3" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#B308090E">
        <Grid.RowDefinitions>
            <!-- Custom TitleBar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area with Navigation Sidebar -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <ui:TitleBar Grid.Row="0"
                     Title="Meridian Cyber OSINT Platform"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     Background="Transparent">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Border Background="#1A00D2FF"
                            BorderBrush="#4D00D2FF"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="7,2"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="headerDot" Width="6" Height="6" Fill="#00D2FF" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#00D2FF" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                                </Ellipse.Effect>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.4" To="1.0" Duration="0:0:1.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="CYBER OSINT"
                                       FontSize="10"
                                       FontWeight="Black"
                                       Foreground="#00D2FF" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Meridian Search Platform"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="#E2E8F0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- MAIN LAYOUT: SIDEBAR + VIEW -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="240" />
                <!-- Content View -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR (Linear / Raycast Style) -->
            <Border Grid.Column="0"
                    Background="#800D0F18"
                    BorderBrush="#1AFFFFFF"
                    BorderThickness="0,0,1,0">
                <Grid Margin="14,18">
                    <Grid.RowDefinitions>
                        <!-- App Branding -->
                        <RowDefinition Height="Auto" />
                        <!-- Navigation Items -->
                        <RowDefinition Height="*" />
                        <!-- Footer / Periodic Health Status -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- BRANDING -->
                    <StackPanel Grid.Row="0" Margin="4,0,0,26">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <!-- Neon Glowing Radar Icon with Breathing Animation -->
                            <Grid Margin="0,0,10,0">
                                <ui:SymbolIcon Symbol="Radar20"
                                               FontSize="22"
                                               Foreground="#00D2FF">
                                    <ui:SymbolIcon.Effect>
                                        <DropShadowEffect Color="#00D2FF" BlurRadius="16" ShadowDepth="0" Opacity="0.8" />
                                    </ui:SymbolIcon.Effect>
                                    <ui:SymbolIcon.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.5" To="1.0" Duration="0:0:1.8">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ui:SymbolIcon.Triggers>
                                </ui:SymbolIcon>
                            </Grid>
                            <TextBlock Text="MERIDIAN"
                                       FontSize="18"
                                       FontWeight="Black"
                                       Foreground="#F8FAFC"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Advanced Reconnaissance Intelligence"
                                   FontSize="10"
                                   Foreground="#64748B" />
                    </StackPanel>

                    <!-- NAVIGATION BUTTONS -->
                    <StackPanel Grid.Row="1">
                        <!-- Search Tab Button -->
                        <RadioButton Height="44"
                                     IsChecked="{Binding CurrentTab, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Search, Mode=OneWay}"
                                     Command="{Binding NavigateToCommand}"
                                     CommandParameter="Search"
                                     Style="{StaticResource CyberNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Search24" Margin="0,0,12,0" FontSize="18" Foreground="#00D2FF" />
                                <TextBlock Text="Поиск целей" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- History Tab Button -->
                        <RadioButton Height="44"
                                     IsChecked="{Binding CurrentTab, Converter={StaticResource StringEqualsToBool}, ConverterParameter=History, Mode=OneWay}"
                                     Command="{Binding NavigateToCommand}"
                                     CommandParameter="History"
                                     Style="{StaticResource CyberNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="History24" Margin="0,0,12,0" FontSize="18" Foreground="#A855F7" />
                                <TextBlock Text="История сессий" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Logs Tab Button -->
                        <RadioButton Height="44"
                                     IsChecked="{Binding CurrentTab, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Logs, Mode=OneWay}"
                                     Command="{Binding NavigateToCommand}"
                                     CommandParameter="Logs"
                                     Style="{StaticResource CyberNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentBulletList24" Margin="0,0,12,0" FontSize="18" Foreground="#38BDF8" />
                                <TextBlock Text="Журнал логов" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Settings Tab Button -->
                        <RadioButton Height="44"
                                     IsChecked="{Binding CurrentTab, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Settings, Mode=OneWay}"
                                     Command="{Binding NavigateToCommand}"
                                     CommandParameter="Settings"
                                     Style="{StaticResource CyberNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0" FontSize="18" Foreground="#00E599" />
                                <TextBlock Text="Настройки" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- FOOTER: Periodic Health Status & Latency Pill -->
                    <Button Grid.Row="2"
                            Command="{Binding CheckHealthCommand}"
                            ToolTip="Нажмите для мгновенной проверки соединения с бэкендом"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="healthBorder"
                                        Background="#33101422"
                                        BorderBrush="#1AFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,10">
                                    <Grid>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <!-- Animated Pulsing Health Dot -->
                                                <Grid Margin="0,0,7,0" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8"
                                                             Fill="{Binding Health.IsHealthy, Converter={StaticResource BoolToBrush}}">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect Color="#00E599" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
                                                        </Ellipse.Effect>
                                                        <Ellipse.Triggers>
                                                            <EventTrigger RoutedEvent="Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1.0" Duration="0:0:1.0">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <SineEase EasingMode="EaseInOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Ellipse.Triggers>
                                                    </Ellipse>
                                                </Grid>

                                                <!-- Status Text (ONLINE 3ms / OFFLINE) -->
                                                <TextBlock Text="{Binding Health.StatusText}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding Health.IsHealthy, Converter={StaticResource BoolToBrush}}"
                                                           VerticalAlignment="Center" />

                                                <ui:ProgressRing Width="11" Height="11"
                                                                 Margin="6,0,0,0"
                                                                 IsIndeterminate="True"
                                                                 Visibility="{Binding Health.IsChecking, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <!-- Backend URL display -->
                                            <TextBlock Text="{Binding Settings.BackendUrl}"
                                                       FontSize="11"
                                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                       Foreground="#94A3B8"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="healthBorder" Property="Background" Value="#4D161C30" />
                                        <Setter TargetName="healthBorder" Property="BorderBrush" Value="#4D00D2FF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- CURRENT ACTIVE VIEW CONTENT (Smooth Fade & Slide) -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentViewModel}">
                <ContentControl.RenderTransform>
                    <TranslateTransform Y="0" />
                </ContentControl.RenderTransform>
                <ContentControl.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1.0" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="8" To="0" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ContentControl.Triggers>
            </ContentControl>
        </Grid>
    </Grid>
</ui:FluentWindow>
