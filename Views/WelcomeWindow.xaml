<ui:FluentWindow x:Class="MeridianClient.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:MeridianClient.Converters"
        mc:Ignorable="d"
        Title="Meridian Recon Hub"
        Icon="pack://application:,,,/Assets/app_icon.png"
        WindowBackdropType="None"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Height="540" Width="1020"
        MinHeight="480" MinWidth="920"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="WelcomeActionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Height" Value="82" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WelcomeRecentCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Meridian Recon Hub"
                     ShowMaximize="False"
                     ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="BranchFork24" Foreground="{DynamicResource AccentBrush}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="36,12,36,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderAccentBrush}"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Margin="0,0,16,0">
                        <ui:SymbolIcon Symbol="BranchFork24" FontSize="24" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MERIDIAN"
                                       FontSize="20"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas" />
                            <Border Background="{DynamicResource SubtleAccentBrush}"
                                    BorderBrush="{DynamicResource BorderAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="RECON 2.0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Welcome_Subtitle}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Welcome_QuickStart}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,12" />

                    <Button Command="{Binding NewInvestigationCommand}"
                            Padding="0" Background="Transparent" BorderThickness="0"
                            HorizontalContentAlignment="Stretch" Margin="0,0,0,10">
                        <Border Style="{StaticResource WelcomeActionCardStyle}">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" Background="{DynamicResource SubtleAccentBrush}" Margin="0,0,14,0">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="20" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Welcome_NewInvestigation}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="{DynamicResource Welcome_NewInvestigationDesc}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Button>

                    <Button Command="{Binding OpenFromFileCommand}"
                            Padding="0" Background="Transparent" BorderThickness="0"
                            HorizontalContentAlignment="Stretch" Margin="0,0,0,10">
                        <Border Style="{StaticResource WelcomeActionCardStyle}">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" Background="#2061AFEF" Margin="0,0,14,0">
                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="20" Foreground="#61AFEF" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Welcome_OpenFromFile}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="{DynamicResource Welcome_OpenFromFileDesc}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Button>
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource Welcome_RecentHeader}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="24"
                            Visibility="{Binding HasRecentInvestigations, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="FolderZip24" FontSize="36" Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.4" Margin="0,0,0,10" />
                            <TextBlock Text="{DynamicResource Welcome_NoRecentTitle}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Welcome_NoRecentDesc}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasRecentInvestigations, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding RecentInvestigations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenInvestigationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Stretch"
                                            Margin="0,0,0,8"
                                            Cursor="Hand">
                                        <Border Style="{StaticResource WelcomeRecentCardStyle}">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource SubtleAccentBrush}" Margin="0,0,12,0">
                                                    <ui:SymbolIcon Symbol="Target24" FontSize="18" Foreground="{DynamicResource AccentBrush}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding FormattedDate, FallbackValue='Недавно'}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <Button Grid.Column="2"
                                                        Command="{Binding DataContext.DeleteInvestigationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Width="32" Height="32"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        ToolTip="Удалить расследование">
                                                    <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
