<UserControl x:Class="MeridianClient.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:MeridianClient.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="WelcomeActionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Height" Value="82" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,32">
        <Grid.RowDefinitions>
            <!-- Header / Branding -->
            <RowDefinition Height="Auto" />
            <!-- Content Split: Actions (Left) / Recent Investigations (Right) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,32">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="48" Height="48"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderAccentBrush}"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Margin="0,0,16,0">
                    <ui:SymbolIcon Symbol="BranchFork24" FontSize="26" Foreground="{DynamicResource AccentBrush}" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="MERIDIAN"
                                   FontSize="22"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontFamily="JetBrains Mono, Cascadia Code, Consolas" />
                        <Border Background="{DynamicResource SubtleAccentBrush}"
                                BorderBrush="{DynamicResource BorderAccentBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="RECON 2.0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Интеллектуальная платформа киберразведки и графового анализа связей"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- MAIN TWO-COLUMN HUB -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Quick Actions (Left) -->
                <ColumnDefinition Width="380" />
                <!-- Spacer -->
                <ColumnDefinition Width="32" />
                <!-- Recent Projects / Investigations (Right) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: QUICK ACTIONS -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="БЫСТРЫЙ СТАРТ"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,14" />

                <!-- 1. New Investigation -->
                <Button Command="{Binding NewInvestigationCommand}"
                        Padding="0" Background="Transparent" BorderThickness="0"
                        HorizontalContentAlignment="Stretch" Margin="0,0,0,12">
                    <Border Style="{StaticResource WelcomeActionCardStyle}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" Background="{DynamicResource SubtleAccentBrush}" Margin="0,0,14,0">
                                <ui:SymbolIcon Symbol="Add24" FontSize="20" Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Новое расследование" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Text="Запуск OSINT-поиска по домену, IP или никнейму" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Button>

                <!-- 2. Open From File -->
                <Button Command="{Binding OpenFromFileCommand}"
                        Padding="0" Background="Transparent" BorderThickness="0"
                        HorizontalContentAlignment="Stretch" Margin="0,0,0,12">
                    <Border Style="{StaticResource WelcomeActionCardStyle}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" Background="#2061AFEF" Margin="0,0,14,0">
                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="20" Foreground="#61AFEF" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Открыть из файла" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Text="Импорт сохраненного расследования (.json)" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Button>
            </StackPanel>

            <!-- RIGHT COLUMN: RECENT INVESTIGATIONS (AUTO-SAVED) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="НЕДАВНИЕ РАССЛЕДОВАНИЯ"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Background="{DynamicResource SubtleAccentBrush}"
                                BorderBrush="{DynamicResource BorderAccentBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2">
                            <TextBlock Text="Автосохранение включено" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Empty State -->
                <Border Grid.Row="1"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="32"
                        Visibility="{Binding HasRecentInvestigations, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="FolderZip24" FontSize="42" Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.4" Margin="0,0,0,12" />
                        <TextBlock Text="Нет недавних расследований"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Создайте новое расследование или запустите поиск по цели слева."
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- List of Recent Investigations -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasRecentInvestigations, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding RecentInvestigations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource WelcomeActionCardStyle}" Margin="0,0,0,8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Target Icon -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource SubtleAccentBrush}" Margin="0,0,12,0">
                                            <ui:SymbolIcon Symbol="Target24" FontSize="18" Foreground="{DynamicResource AccentBrush}" />
                                        </Border>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Text="{Binding FormattedDate, FallbackValue='Недавно'}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Open Button -->
                                        <Button Grid.Column="2"
                                                Content="Открыть"
                                                Command="{Binding DataContext.OpenInvestigationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{DynamicResource AccentButtonStyle}"
                                                Padding="12,6"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Margin="0,0,8,0" />

                                        <!-- Delete Button -->
                                        <Button Grid.Column="3"
                                                Command="{Binding DataContext.DeleteInvestigationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Width="32" Height="32"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="Удалить расследование">
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
