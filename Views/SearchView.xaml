                                                        Padding="10,0"
                                                        Margin="0,0,8,6"
                                                        Visibility="{Binding DomainSecurityTxtData.HasHiring, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Briefcase24" FontSize="13" Foreground="#00D2FF" Margin="0,0,6,0" />
                                                        <TextBlock Text="Careers / Hiring" FontSize="11" FontWeight="Bold" Foreground="#00D2FF" />
                                                    </StackPanel>
                                                </Button>

                                                <Button Command="{Binding OpenUrlCommand}"
                                                        CommandParameter="{Binding DomainSecurityTxtData.Url}"
                                                        Style="{StaticResource CyberGhostButtonStyle}"
                                                        Height="30"
                                                        Padding="10,0"
                                                        Margin="0,0,8,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Document24" FontSize="13" Foreground="#94A3B8" Margin="0,0,6,0" />
                                                        <TextBlock Text="View security.txt" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                                    </StackPanel>
                                                </Button>
