                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="13" Foreground="#00E599" Margin="0,0,6,0" />
                                                        <TextBlock Text="Bug Bounty Policy" FontSize="11" FontWeight="Bold" Foreground="#00E599" />
                                                    </StackPanel>
                                                </Button>

                                                <Button Command="{Binding OpenUrlCommand}"
                                                        CommandParameter="{Binding DomainSecurityTxtData.AcknowledgmentsUrl}"
                                                        Style="{StaticResource CyberGhostButtonStyle}"
                                                        Height="30"
                                                        Padding="10,0"
                                                        Margin="0,0,8,6"
                                                        Visibility="{Binding DomainSecurityTxtData.HasAcknowledgments, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Trophy24" FontSize="13" Foreground="#FFB800" Margin="0,0,6,0" />
                                                        <TextBlock Text="Hall of Fame" FontSize="11" FontWeight="Bold" Foreground="#FFB800" />
                                                    </StackPanel>
                                                </Button>

                                                <Button Command="{Binding OpenUrlCommand}"
                                                        CommandParameter="{Binding DomainSecurityTxtData.HiringUrl}"
                                                        Style="{StaticResource CyberGhostButtonStyle}"
