<Window x:Class="MeridianClient.Views.AvatarPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Просмотр аватара"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="350"
        SizeToContent="Height"
        ShowInTaskbar="False">

    <Border x:Name="mainContainerBorder"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="18"
            Margin="10"
            Opacity="0">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                <TranslateTransform Y="10" />
            </TransformGroup>
        </Border.RenderTransform>
        <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>

        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.20">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                         From="0.94" To="1.0" Duration="0:0:0.22">
                            <DoubleAnimation.EasingFunction>
                                <BackEase Amplitude="0.25" EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                         From="0.94" To="1.0" Duration="0:0:0.22">
                            <DoubleAnimation.EasingFunction>
                                <BackEase Amplitude="0.25" EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                         From="10" To="0" Duration="0:0:0.20">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.65" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="iconBadge"
                        Grid.Column="0"
                        Width="38" Height="38"
                        CornerRadius="10"
                        Background="#268957E5"
                        BorderBrush="#668957E5"
                        BorderThickness="1"
                        Margin="0,0,14,0">
                    <ui:SymbolIcon x:Name="dialogIcon"
                                   Symbol="PersonCircle24"
                                   FontSize="18"
                                   Foreground="#8957E5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="txtTitle"
                           Grid.Column="1"
                           Text="Аватар профиля"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center" />

                <Button Grid.Column="2"
                        Click="BtnClose_Click"
                        Width="30" Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Закрыть">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,4,0,20" HorizontalAlignment="Center">
                <Border x:Name="avatarGlowBorder"
                        Width="160" Height="160"
                        CornerRadius="80"
                        Background="#10FFFFFF"
                        BorderBrush="#8957E5"
                        BorderThickness="2.5"
                        HorizontalAlignment="Center"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect x:Name="avatarGlowEffect" Color="#8957E5" BlurRadius="22" ShadowDepth="0" Opacity="0.5" />
                    </Border.Effect>
                    <Grid>
                        <ui:SymbolIcon x:Name="avatarFallbackIcon"
                                       Symbol="PersonCircle24"
                                       FontSize="72"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        <Image x:Name="imgAvatar"
                               Stretch="UniformToFill"
                               Width="160" Height="160" />
                    </Grid>
                </Border>

                <TextBlock x:Name="txtDisplayName"
                           Text="@username"
                           FontSize="16"
                           FontWeight="Bold"
                           FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,3" />

                <TextBlock x:Name="txtSubtitle"
                           Text="Subtitle"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="300"
                           TextAlignment="Center" />
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        x:Name="btnClose"
                        Click="BtnClose_Click"
                        IsCancel="True"
                        Height="36"
                        Padding="14,0"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        Background="{DynamicResource AppBackgroundBrush}"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock x:Name="txtCloseLabel" Text="Закрыть" FontSize="12" FontWeight="SemiBold" />
                </Button>

                <Button Grid.Column="2"
                        x:Name="btnOpenProfile"
                        Click="BtnOpenProfile_Click"
                        IsDefault="True"
                        Height="36"
                        Padding="14,0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b"
                                                Background="#E08957E5"
                                                BorderBrush="#8957E5"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <Border.Effect>
                                                <DropShadowEffect x:Name="btnShadow" Color="#8957E5" BlurRadius="14" ShadowDepth="0" Opacity="0.45" />
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#FF8957E5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Open24" FontSize="13" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="txtOpenProfileLabel" Text="Открыть профиль" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>