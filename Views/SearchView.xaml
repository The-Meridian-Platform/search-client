                                                        <TextBlock Text="EXPIRES: " FontSize="9" FontWeight="Bold" Foreground="#64748B" />
                                                        <TextBlock Text="{Binding DomainSecurityTxtData.Expires}" FontFamily="JetBrains Mono" FontSize="10" Foreground="#CBD5E1" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Row 1: Action Link Buttons -->
                                            <WrapPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal">
