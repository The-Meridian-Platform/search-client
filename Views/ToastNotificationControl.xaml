<UserControl x:Class="MeridianClient.Views.ToastNotificationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Visibility="Collapsed"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom">

    <Border x:Name="toastContainer"
            Background="#F4111723"
            BorderThickness="1"
            CornerRadius="10"
            MinWidth="320"
            MaxWidth="440"
            ClipToBounds="True"
            Opacity="0"
            MouseEnter="Toast_MouseEnter"
            MouseLeave="Toast_MouseLeave">

        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="toastScale" ScaleX="1.0" ScaleY="1.0" />
                <TranslateTransform x:Name="toastTranslate" X="50" Y="0" />
            </TransformGroup>
        </Border.RenderTransform>
        <Border.RenderTransformOrigin>1.0,0.5</Border.RenderTransformOrigin>

        <Border.Effect>
            <DropShadowEffect x:Name="toastShadow" Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.6" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ProgressBar x:Name="timeProgressBar"
                         Grid.Row="0"
                         Height="2.5"
                         Minimum="0"
                         Maximum="1"
                         Value="1"
                         Background="#20FFFFFF"
                         Margin="14,10,14,0"
                         BorderThickness="0">
                <ProgressBar.Template>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="1.25"
                                Height="{TemplateBinding Height}">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="1.25"
                                        Height="{TemplateBinding Height}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </ProgressBar.Template>
            </ProgressBar>

            <Grid Grid.Row="1" Margin="14,10,14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="iconBadge"
                        Grid.Column="0"
                        Width="32" Height="32"
                        CornerRadius="8"
                        BorderThickness="1"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <ui:SymbolIcon x:Name="symbolIcon"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="txtTitle"
                               FontWeight="SemiBold"
                               FontSize="13"
                               FontFamily="JetBrains Mono, Segoe UI, sans-serif"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="txtMessage"
                               FontSize="12"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextWrapping="Wrap"
                               LineHeight="16"
                               Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="2"
                        Click="BtnDismiss_Click"
                        Width="22" Height="22"
                        Padding="0"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Закрыть">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b"
                                                Background="Transparent"
                                                CornerRadius="11"
                                                Padding="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#25FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
