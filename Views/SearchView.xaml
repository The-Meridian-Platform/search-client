<UserControl x:Class="MeridianClient.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MeridianClient.ViewModels"
             xmlns:conv="clr-namespace:MeridianClient.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:SearchViewModel}"
             d:DesignHeight="780" d:DesignWidth="1050">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StatusToBrushConverter x:Key="StatusToBrush" />
        <conv:FindingTypeToBrushConverter x:Key="TypeToBrush" />
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
        <conv:StringEqualsToBooleanConverter x:Key="StringEqualsToBool" />

        <!-- Linear / Raycast Filter Button Style -->
        <Style x:Key="CyberFilterChipStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="GroupName" Value="FindingsCategoryFilters" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="chipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Ghost Action Button Style -->
        <Style x:Key="CyberGhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ghostBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ghostBorder" Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
                                <Setter TargetName="ghostBorder" Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,24">
        <Grid.RenderTransform>
            <TranslateTransform Y="0" />
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.25">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.25">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <!-- Search Control Bar -->
            <RowDefinition Height="Auto" />
            <!-- Status & Metrics HUD -->
            <RowDefinition Height="Auto" />
            <!-- Filter Bar -->
            <RowDefinition Height="Auto" />
            <!-- Findings Feed -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP BAR: Target input & Start Search -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Target Input Box -->
                <ui:TextBox Grid.Column="0"
                            Text="{Binding TargetInput, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{DynamicResource Search_TargetPlaceholder}"
                            Icon="{ui:SymbolIcon Globe24}"
                            Margin="0,0,10,0"
                            VerticalContentAlignment="Center"
                            Height="42"
                            KeyDown="TargetInput_KeyDown"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            Background="{DynamicResource AppBackgroundBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                            FontSize="13">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding StartSearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <!-- Target Type ComboBox -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding TargetTypes}"
                          SelectedItem="{Binding SelectedTargetType}"
                          Margin="0,0,10,0"
                          Height="42"
                          VerticalContentAlignment="Center"
                          Background="{DynamicResource AppBackgroundBrush}"
                          Foreground="{DynamicResource PrimaryTextBrush}"
                          BorderBrush="{DynamicResource CardBorderBrush}" />

                <!-- Ultra-Premium Neon Cyan Start Search Button -->
                <Button Grid.Column="2"
                        Height="42"
                        Padding="22,0"
                        Margin="0,0,8,0"
                        Command="{Binding StartSearchCommand}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="neonBorder"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="neonBorder" Property="Opacity" Value="0.9" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="neonBorder" Property="Background" Value="{DynamicResource CardBorderBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Search24" Margin="0,0,8,0" Foreground="#040914" FontSize="16" />
                        <TextBlock Text="{DynamicResource Search_StartButton}" FontWeight="Bold" FontSize="13" Foreground="#040914" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Stop Search Button (Neon Red) -->
                <Button Grid.Column="3"
                        Height="42"
                        Padding="16,0"
                        Margin="0,0,8,0"
                        Command="{Binding StopSearchCommand}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="stopBorder"
                                    Background="#26FF3366"
                                    BorderBrush="#FF3366"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF3366" BlurRadius="16" ShadowDepth="0" Opacity="0.6" />
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="stopBorder" Property="Background" Value="#40FF3366" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Stop24" Margin="0,0,6,0" Foreground="#FF3366" />
                        <TextBlock Text="{DynamicResource Search_StopButton}" FontWeight="SemiBold" Foreground="#FF3366" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Clear Button -->
                <Button Grid.Column="4"
                        Height="42"
                        Padding="16,0"
                        Command="{Binding ClearResultsCommand}"
                        Style="{StaticResource CyberGhostButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Delete24" Margin="0,0,6,0" FontSize="15" />
                        <TextBlock Text="{DynamicResource Search_ClearButton}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- STATUS & METRICS HUD STRIP (Linear / Cyber OSINT) -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Session Status Badge -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Elapsed Time -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Counters (Total / DNS / Whois) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Status message text -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Status Badge with Glowing Dot -->
                <Border Grid.Column="0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,5"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8"
                                 Fill="{Binding SessionStatus, Converter={StaticResource StatusToBrush}}"
                                 Margin="0,0,8,0">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1.0" Duration="0:0:0.9">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="{Binding SessionStatus}"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <ui:ProgressRing Width="14" Height="14"
                                         Margin="8,0,0,0"
                                         IsIndeterminate="True"
                                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Elapsed Timer (Monospace) -->
                <Border Grid.Column="1"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,5"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Timer24" Margin="0,0,7,0" FontSize="14" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="ВРЕМЯ: " Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ElapsedTime}"
                                   FontWeight="Bold"
                                   FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Finding Counters (Raycast Glass Pills) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <!-- Total Counter with Cyan Glow -->
                    <Border Background="#1A00D2FF"
                            BorderBrush="#4D00D2FF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,4"
                            Margin="0,0,8,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#00D2FF" BlurRadius="12" ShadowDepth="0" Opacity="0.4" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Search_Metric_Findings}" Foreground="#67E8F9" FontSize="10" FontWeight="Bold" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding TotalFindingsCount}"
                                       FontWeight="Black"
                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                       Foreground="#00D2FF"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>

                    <!-- DNS Counter -->
                    <Border Background="#1A3B82F6"
                            BorderBrush="#333B82F6"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,4"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Search_Metric_DNS}" Foreground="#93C5FD" FontSize="10" FontWeight="Bold" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding DnsFindingsCount}"
                                       FontWeight="Bold"
                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                       Foreground="#60A5FA"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>

                    <!-- WHOIS Counter -->
                    <Border Background="#1AFF007F"
                            BorderBrush="#33FF007F"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,4"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Search_Metric_WHOIS}" Foreground="#F472B6" FontSize="10" FontWeight="Bold" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding WhoisFindingsCount}"
                                       FontWeight="Bold"
                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                       Foreground="#FF007F"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>

                    <!-- Subdomains Counter -->
                    <Border Background="#1A00F0FF"
                            BorderBrush="#3300F0FF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,4"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Search_Metric_Subdomains}" Foreground="#67E8F9" FontSize="10" FontWeight="Bold" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding SubdomainFindingsCount}"
                                       FontWeight="Bold"
                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                       Foreground="#00F0FF"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>

                    <!-- Web Tech Counter -->
                    <Border Background="#1A00E599"
                            BorderBrush="#3300E599"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,4"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Search_Metric_Tech}" Foreground="#6EE7B7" FontSize="10" FontWeight="Bold" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding HttpTechFindingsCount}"
                                       FontWeight="Bold"
                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                       Foreground="#00E599"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>

                    <!-- Email / Profiles Counter -->
                    <Border Background="#1A8957E5"
                            BorderBrush="#338957E5"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,4"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Search_Metric_Email}" Foreground="#C084FC" FontSize="10" FontWeight="Bold" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding EmailFindingsCount}"
                                       FontWeight="Bold"
                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                       Foreground="#8957E5"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Border Background="#1A00D2FF"
                            BorderBrush="#3300D2FF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="IP:" Foreground="#67E8F9" FontSize="10" FontWeight="Bold" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding IpFindingsCount}"
                                       FontWeight="Bold"
                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                       Foreground="#00D2FF"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Status Message -->
                <TextBlock Grid.Column="3"
                           Text="{Binding StatusMessage}"
                           Foreground="#94A3B8"
                           FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- FILTER & QUICK SEARCH BAR -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Toggle Filter Button (+) & Collapsible Filter Chips Container -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Neon Plus (+) Toggle Button with Smooth Rotate Animation -->
                <ToggleButton x:Name="btnToggleFilters"
                              IsChecked="{Binding IsFiltersPanelOpen, Mode=TwoWay}"
                              Cursor="Hand"
                              ToolTip="Показать / скрыть фильтры по категориям"
                              Margin="0,0,10,0">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="toggleBorder"
                                    Width="36" Height="36"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <ui:SymbolIcon x:Name="plusIcon"
                                                   Symbol="Add24"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   RenderTransformOrigin="0.5,0.5">
                                        <ui:SymbolIcon.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </ui:SymbolIcon.RenderTransform>
                                    </ui:SymbolIcon>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="toggleBorder" Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
                                    <Setter TargetName="toggleBorder" Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}" />
                                    <Setter TargetName="plusIcon" Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="toggleBorder" Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
                                    <Setter TargetName="toggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="plusIcon" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="toggleBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#00D2FF" BlurRadius="14" ShadowDepth="0" Opacity="0.55" />
                                        </Setter.Value>
                                    </Setter>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="plusIcon"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 To="45" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="plusIcon"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 To="0" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <!-- Animated Filter Chips Panel (Sliding & Fading in/out) -->
                <Border x:Name="filterChipsPanel" ClipToBounds="True" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="0" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="-25" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFiltersPanelOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.0" To="1.0" Duration="0:0:0.28">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 From="-25" To="0" Duration="0:0:0.28">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="0.0" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 To="-25" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{DynamicResource Search_FilterAll}"
                                     IsChecked="{Binding ActiveFilter, Converter={StaticResource StringEqualsToBool}, ConverterParameter=All, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}"
                                     CommandParameter="All"
                                     Style="{StaticResource CyberFilterChipStyle}" />
                        <RadioButton Content="{DynamicResource Search_FilterEmail}"
                                     IsChecked="{Binding ActiveFilter, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Email, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}"
                                     CommandParameter="Email"
                                     Style="{StaticResource CyberFilterChipStyle}" />
                        <RadioButton Content="{DynamicResource Search_FilterDNS}"
                                     IsChecked="{Binding ActiveFilter, Converter={StaticResource StringEqualsToBool}, ConverterParameter=DNS, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}"
                                     CommandParameter="DNS"
                                     Style="{StaticResource CyberFilterChipStyle}" />
                        <RadioButton Content="{DynamicResource Search_FilterWhois}"
                                     IsChecked="{Binding ActiveFilter, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Whois, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}"
                                     CommandParameter="Whois"
                                     Style="{StaticResource CyberFilterChipStyle}" />
                        <RadioButton Content="{DynamicResource Search_FilterSubdomains}"
                                     IsChecked="{Binding ActiveFilter, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Subdomains, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}"
                                     CommandParameter="Subdomains"
                                     Style="{StaticResource CyberFilterChipStyle}" />
                        <RadioButton Content="{DynamicResource Search_FilterTech}"
                                     IsChecked="{Binding ActiveFilter, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Tech, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}"
                                     CommandParameter="Tech"
                                     Style="{StaticResource CyberFilterChipStyle}" />
                        <RadioButton Content="IP"
                                     IsChecked="{Binding ActiveFilter, Converter={StaticResource StringEqualsToBool}, ConverterParameter=IP, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}"
                                     CommandParameter="IP"
                                     Style="{StaticResource CyberFilterChipStyle}" />
                        <RadioButton Content="{DynamicResource Search_FilterOther}"
                                     IsChecked="{Binding ActiveFilter, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Other, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}"
                                     CommandParameter="Other"
                                     Style="{StaticResource CyberFilterChipStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Quick Filter / Search inside findings -->
            <ui:TextBox Grid.Column="1"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{DynamicResource Search_FilterPlaceholder}"
                        Icon="{ui:SymbolIcon Filter24}"
                        HorizontalAlignment="Right"
                        Width="340"
                        Height="36"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        Background="{DynamicResource AppBackgroundBrush}"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                        FontSize="12" />
        </Grid>

        <!-- FINDINGS FEED LIST (WITH SMOOTH FADE-IN ANIMATION) -->
        <Grid Grid.Row="3">
            <!-- Empty state when no findings -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="48"
                    Visibility="{Binding Findings.Count, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,18">
                        <ui:SymbolIcon Symbol="SearchVisual24" FontSize="56" Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.4" />
                        <ui:SymbolIcon Symbol="SearchVisual24" FontSize="56" Foreground="{DynamicResource AccentBrush}" Opacity="0.3">
                            <ui:SymbolIcon.Effect>
                                <DropShadowEffect Color="#00D2FF" BlurRadius="30" ShadowDepth="0" Opacity="0.4" />
                            </ui:SymbolIcon.Effect>
                        </ui:SymbolIcon>
                    </Grid>
                    <TextBlock Text="{DynamicResource Search_EmptyTitle}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource Search_EmptyDesc}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="13"
                               TextAlignment="Center"
                               MaxWidth="480"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Scrollable list of findings with animated cards -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FindingsView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FindingItemViewModel}">
                            <!-- Animated Finding Card with Hover Glow -->
                            <Border BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16"
                                    Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#00D2FF" BlurRadius="16" ShadowDepth="0" Opacity="0.25" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <!-- FAST DISMISS FLY-AWAY ANIMATION ON CLEAR -->
                                            <DataTrigger Binding="{Binding IsDismissing}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             To="0.0" Duration="0:0:0.18">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseIn" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                             To="120" Duration="0:0:0.18">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseIn" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                             To="-20" Duration="0:0:0.18">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseIn" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.RenderTransform>
                                    <TranslateTransform X="0" Y="0" />
                                </Border.RenderTransform>

                                <!-- SMOOTH FADE-IN & SLIDE ANIMATION ON ARRIVAL -->
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.0" To="1.0"
                                                                 Duration="0:0:0.32">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 From="14" To="0"
                                                                 Duration="0:0:0.32">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <!-- Header row: Type badge, Provider, Timestamp, Raw JSON button -->
                                        <RowDefinition Height="Auto" />
                                        <!-- Middle row: Structured details (DNS or Whois or Generic) -->
                                        <RowDefinition Height="Auto" />
                                        <!-- Bottom row: Raw JSON accordion -->
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- HEADER ROW -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Glowing Dynamic Type Badge -->
                                        <Border Grid.Column="0"
                                                Background="{Binding TypeBadgeBackground}"
                                                BorderBrush="{Binding TypeBadgeColor}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,3"
                                                Margin="0,0,10,0">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#00D2FF" BlurRadius="10" ShadowDepth="0" Opacity="0.35" />
                                            </Border.Effect>
                                            <TextBlock Text="{Binding TypeBadgeText}"
                                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                       FontWeight="Bold"
                                                       FontSize="11"
                                                       Foreground="{Binding TypeBadgeColor}" />
                                        </Border>

                                        <!-- Provider Badge -->
                                        <Border Grid.Column="1"
                                                Background="#261E293B"
                                                BorderBrush="#1AFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="SRC: " Foreground="#64748B" FontSize="10" FontWeight="Bold" />
                                                <TextBlock Text="{Binding ProviderKey}"
                                                           FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                           FontWeight="SemiBold"
                                                           Foreground="#CBD5E1"
                                                           FontSize="11" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Timestamp (Monospace) -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding CreatedAt}"
                                                   FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                   Foreground="#64748B"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" />

                                        <!-- Expand/Collapse Raw JSON Button -->
                                        <Button Grid.Column="3"
                                                Command="{Binding ToggleExpandCommand}"
                                                Padding="10,4"
                                                FontSize="11"
                                                Style="{StaticResource CyberGhostButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Code24" Margin="0,0,5,0" FontSize="13" Foreground="#00D2FF" />
                                                <TextBlock Text="JSON" FontFamily="JetBrains Mono, Cascadia Code, Consolas" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- MIDDLE ROW: STRUCTURED DATA -->

                                    <!-- 1. DNS Content Template -->
                                    <StackPanel Grid.Row="1"
                                                Visibility="{Binding IsDns, Converter={StaticResource BoolToVis}}"
                                                Margin="0,4,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Host & Target / IP (Monospace) -->
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DnsData.Value}"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                               Foreground="{Binding DnsData.RecordTypeColor}"
                                                               TextWrapping="Wrap" />
                                                    <Button Command="{Binding CopyValueCommand}"
                                                            CommandParameter="{Binding DnsData.Value}"
                                                            ToolTip="Скопировать значение DNS"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="4,0"
                                                            Margin="6,0,0,0"
                                                            Cursor="Hand"
                                                            VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Copy24" FontSize="13" Foreground="#64748B" />
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <ui:SymbolIcon Symbol="Globe24" FontSize="12" Foreground="#64748B" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DnsData.Name}"
                                                               FontSize="12"
                                                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                               Foreground="#94A3B8"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- TTL & Priority Badges (Monospace) -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#1AFFFFFF"
                                                        BorderBrush="#1AFFFFFF"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8,3"
                                                        Margin="6,0,0,0"
                                                        Visibility="{Binding DnsData.HasTtl, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding DnsData.Ttl, StringFormat='TTL {0}s'}"
                                                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="#94A3B8" />
                                                </Border>

                                                <Border Background="#26FF7A00"
                                                        BorderBrush="#4DFF7A00"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8,3"
                                                        Margin="6,0,0,0"
                                                        Visibility="{Binding DnsData.HasPriority, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding DnsData.Priority, StringFormat='PRIO {0}'}"
                                                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="#FF7A00" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- 2. WHOIS Content Template -->
                                    <StackPanel Grid.Row="1"
                                                Visibility="{Binding IsWhois, Converter={StaticResource BoolToVis}}"
                                                Margin="0,4,0,4">
                                        <!-- Header: Domain & Copy & Status -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding WhoisData.DomainName}"
                                                           FontSize="17"
                                                           FontWeight="Black"
                                                           FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                           Foreground="#F8FAFC"
                                                           VerticalAlignment="Center" />
                                                <Button Command="{Binding CopyValueCommand}"
                                                        CommandParameter="{Binding WhoisData.DomainName}"
                                                        ToolTip="Скопировать домен"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="4,0"
                                                        Margin="6,0,0,0"
                                                        Cursor="Hand"
                                                        VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Copy24" FontSize="13" Foreground="#64748B" />
                                                </Button>
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Background="#26334155"
                                                    BorderBrush="#1AFFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,4"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding WhoisData.HasStatus, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding WhoisData.Status}"
                                                           FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                           FontSize="11"
                                                           Foreground="#94A3B8" />
                                            </Border>
                                        </Grid>

                                        <!-- WHOIS 4 Structured Detail Blocks -->
                                        <Border Background="#120D1524"
                                                BorderBrush="#1AFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Registrar -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="РЕГИСТРАТОР" Foreground="#64748B" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding WhoisData.Registrar, TargetNullValue='—', FallbackValue='—'}"
                                                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               Foreground="#00E599"
                                                               Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Created Date -->
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="СОЗДАН" Foreground="#64748B" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding WhoisData.CreatedDate, TargetNullValue='—', FallbackValue='—'}"
                                                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                               FontSize="12"
                                                               Foreground="#CBD5E1"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>

                                                <!-- Expires Date -->
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="ИСТЕКАЕТ" Foreground="#64748B" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding WhoisData.ExpiresDate, TargetNullValue='—', FallbackValue='—'}"
                                                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                               FontSize="12"
                                                               Foreground="#FFB800"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>

                                                <!-- Country / Org -->
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="СТРАНА / ОБНОВЛЕН" Foreground="#64748B" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding WhoisData.RegistrantCountry, TargetNullValue='—', FallbackValue='—'}"
                                                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                               FontSize="12"
                                                               Foreground="#00D2FF"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Nameservers row (if present in WHOIS) -->
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,2,0,0"
                                                    Visibility="{Binding WhoisData.HasNameServers, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="DNS-СЕРВЕРЫ: " Foreground="#64748B" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                            <ItemsControl ItemsSource="{Binding WhoisData.NameServers}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1AFFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="4,0,4,0">
                                                            <TextBlock Text="{Binding}" FontFamily="JetBrains Mono, Cascadia Code" FontSize="10" Foreground="#CBD5E1" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 3. Subdomain Content Template -->
                                    <StackPanel Grid.Row="1"
                                                Visibility="{Binding IsSubdomain, Converter={StaticResource BoolToVis}}"
                                                Margin="0,4,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Subdomain Name & Issuer -->
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding SubdomainData.Subdomain}"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                               Foreground="#00F0FF"
                                                               TextWrapping="Wrap" />
                                                    <Button Command="{Binding CopyValueCommand}"
                                                            CommandParameter="{Binding SubdomainData.Subdomain}"
                                                            ToolTip="Скопировать поддомен"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="4,0"
                                                            Margin="6,0,0,0"
                                                            Cursor="Hand"
                                                            VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Copy24" FontSize="13" Foreground="#64748B" />
                                                    </Button>
                                                </StackPanel>

                                                <!-- Issuer & Validity -->
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                                            Visibility="{Binding SubdomainData.HasIssuer, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Shield24" FontSize="11" Foreground="#00D2FF" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding SubdomainData.Issuer}" FontFamily="JetBrains Mono, Cascadia Code, Consolas" FontSize="11" Foreground="#CBD5E1" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="#15FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="4" Padding="6,2"
                                                            Visibility="{Binding SubdomainData.HasValidity, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Calendar24" FontSize="11" Foreground="#64748B" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding SubdomainData.ValidFrom}" FontFamily="JetBrains Mono, Cascadia Code, Consolas" FontSize="10" Foreground="#94A3B8" />
                                                            <TextBlock Text=" → " FontSize="10" Foreground="#64748B" />
                                                            <TextBlock Text="{Binding SubdomainData.ValidTo}" FontFamily="JetBrains Mono, Cascadia Code, Consolas" FontSize="10" Foreground="#94A3B8" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Right: Status Badge -->
                                            <Border Grid.Column="1"
                                                    Background="#1A00F0FF"
                                                    BorderBrush="#4D00F0FF"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,5"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="CERT LOG" FontSize="10" FontWeight="Bold" Foreground="#00F0FF" FontFamily="JetBrains Mono" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                    <!-- 4. HTTP Tech Content Template -->
                                    <StackPanel Grid.Row="1"
                                                Visibility="{Binding IsHttpTech, Converter={StaticResource BoolToVis}}"
                                                Margin="0,4,0,4">
                                        <!-- Top Row: Page Title & HTTP Status Code -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding HttpTechData.Title, FallbackValue='(Заголовок страницы отсутствует)'}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Foreground="#F8FAFC"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <ui:SymbolIcon Symbol="Globe24" FontSize="12" Foreground="#64748B" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding HttpTechData.Url}"
                                                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                               FontSize="12"
                                                               Foreground="#38BDF8"
                                                               VerticalAlignment="Center" />
                                                    <Button Command="{Binding CopyValueCommand}"
                                                            CommandParameter="{Binding HttpTechData.Url}"
                                                            ToolTip="Скопировать URL"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="4,0"
                                                            Margin="6,0,0,0"
                                                            Cursor="Hand"
                                                            VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Copy24" FontSize="13" Foreground="#64748B" />
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- HTTP Status Code Pill -->
                                            <Border Grid.Column="1"
                                                    Background="{Binding HttpTechData.StatusBackground}"
                                                    BorderBrush="{Binding HttpTechData.StatusColor}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12,5"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding HttpTechData.StatusBadgeText}"
                                                           FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           Foreground="{Binding HttpTechData.StatusColor}" />
                                            </Border>
                                        </Grid>

                                        <!-- Middle: Server, Framework, Content-Type & Security Posture -->
                                        <Border Background="#100C1420"
                                                BorderBrush="#1AFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,8"
                                                Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Server & Framework -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Server -->
                                                    <Border Background="#1AFFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                            Visibility="{Binding HttpTechData.HasServer, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="SERVER: " Foreground="#64748B" FontSize="9" FontWeight="Bold" />
                                                            <TextBlock Text="{Binding HttpTechData.Server}" FontFamily="JetBrains Mono, Cascadia Code, Consolas" FontSize="10" Foreground="#E2E8F0" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Framework / Powered-By -->
                                                    <Border Background="#20A855F7" BorderBrush="#4DA855F7" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                            Visibility="{Binding HttpTechData.HasPoweredBy, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="POWERED: " Foreground="#A855F7" FontSize="9" FontWeight="Bold" />
                                                            <TextBlock Text="{Binding HttpTechData.PoweredBy}" FontFamily="JetBrains Mono, Cascadia Code, Consolas" FontSize="10" Foreground="#E2E8F0" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Content-Type -->
                                                    <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding HttpTechData.ContentType}" FontFamily="JetBrains Mono, Cascadia Code, Consolas" FontSize="10" Foreground="#94A3B8" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Security Badges: HSTS, CSP, X-Frame -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- HSTS Badge -->
                                                    <Border CornerRadius="4" Margin="3,0,3,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#15475569" />
                                                                <Setter Property="BorderBrush" Value="#25475569" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Setter Property="Padding" Value="6,2" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HttpTechData.HasHsts}" Value="True">
                                                                        <Setter Property="Background" Value="#2500E599" />
                                                                        <Setter Property="BorderBrush" Value="#00E599" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="HSTS" FontSize="9" FontWeight="Bold" FontFamily="JetBrains Mono">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#64748B" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HttpTechData.HasHsts}" Value="True">
                                                                            <Setter Property="Foreground" Value="#00E599" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- CSP Badge -->
                                                    <Border CornerRadius="4" Margin="3,0,3,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#15475569" />
                                                                <Setter Property="BorderBrush" Value="#25475569" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Setter Property="Padding" Value="6,2" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HttpTechData.HasCsp}" Value="True">
                                                                        <Setter Property="Background" Value="#2500E599" />
                                                                        <Setter Property="BorderBrush" Value="#00E599" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="CSP" FontSize="9" FontWeight="Bold" FontFamily="JetBrains Mono">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#64748B" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HttpTechData.HasCsp}" Value="True">
                                                                            <Setter Property="Foreground" Value="#00E599" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- X-Frame-Options Badge -->
                                                    <Border CornerRadius="4" Margin="3,0,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#15475569" />
                                                                <Setter Property="BorderBrush" Value="#25475569" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Setter Property="Padding" Value="6,2" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HttpTechData.HasXFrameOptions}" Value="True">
                                                                        <Setter Property="Background" Value="#2500E599" />
                                                                        <Setter Property="BorderBrush" Value="#00E599" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="X-FRAME" FontSize="9" FontWeight="Bold" FontFamily="JetBrains Mono">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#64748B" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HttpTechData.HasXFrameOptions}" Value="True">
                                                                            <Setter Property="Foreground" Value="#00E599" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- 5. GitHub Profile Template -->
                                    <StackPanel Grid.Row="1"
                                                Visibility="{Binding IsGitHubEmail, Converter={StaticResource BoolToVis}}"
                                                Margin="0,4,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                    Command="{Binding PreviewAvatarCommand}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Margin="0,0,14,0"
                                                    Cursor="Hand"
                                                    ToolTip="Просмотреть аватар">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="avatarBorder"
                                                                Width="48" Height="48"
                                                                CornerRadius="24"
                                                                Background="#1A8957E5"
                                                                BorderBrush="#4D8957E5"
                                                                BorderThickness="1.5"
                                                                ClipToBounds="True">
                                                            <Grid>
                                                                <ui:SymbolIcon Symbol="PersonCircle24" FontSize="26" Foreground="#8957E5"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <Image Source="{Binding GitHubEmailData.AvatarUrl}"
                                                                       Stretch="UniformToFill"
                                                                       Width="48" Height="48"
                                                                       Visibility="{Binding GitHubEmailData.HasAvatar, Converter={StaticResource BoolToVis}}" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="avatarBorder" Property="BorderBrush" Value="#8957E5" />
                                                                <Setter TargetName="avatarBorder" Property="Background" Value="#338957E5" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GitHubEmailData.FormattedUsername}"
                                                               FontSize="16"
                                                               FontWeight="Black"
                                                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                               Foreground="#F8FAFC"
                                                               VerticalAlignment="Center" />

                                                    <!-- Account Type Pill -->
                                                    <Border Background="#208957E5"
                                                            BorderBrush="#4D8957E5"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8,2"
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding GitHubEmailData.AccountType}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   FontFamily="JetBrains Mono"
                                                                   Foreground="#C084FC" />
                                                    </Border>

                                                    <!-- Copy Username Button -->
                                                    <Button Command="{Binding CopyValueCommand}"
                                                            CommandParameter="{Binding GitHubEmailData.Username}"
                                                            ToolTip="Скопировать никнейм"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="4,0"
                                                            Margin="6,0,0,0"
                                                            Cursor="Hand"
                                                            VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Copy24" FontSize="13" Foreground="#64748B" />
                                                    </Button>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="GITHUB ID: " FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                                    <TextBlock Text="{Binding GitHubEmailData.Id}"
                                                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                               FontSize="11"
                                                               Foreground="#94A3B8"
                                                               Margin="0,0,12,0" />

                                                    <TextBlock Text="{DynamicResource Search_Card_Profile_Url}" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding GitHubEmailData.ProfileUrl}"
                                                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                               FontSize="11"
                                                               Foreground="#8957E5"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Open in Browser Button -->
                                            <Button Grid.Column="2"
                                                    Command="{Binding OpenUrlCommand}"
                                                    CommandParameter="{Binding GitHubEmailData.ProfileUrl}"
                                                    Style="{StaticResource CyberGhostButtonStyle}"
                                                    VerticalAlignment="Center"
                                                    Height="34"
                                                    Padding="12,0"
                                                    ToolTip="Открыть профиль на GitHub в браузере">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Open24" FontSize="13" Foreground="#8957E5" Margin="0,0,6,0" />
                                                    <TextBlock Text="{DynamicResource Search_Card_Profile_Btn}" FontSize="11" FontWeight="Bold" Foreground="#8957E5" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- 6. Gravatar Profile Template -->
                                    <StackPanel Grid.Row="1"
                                                Visibility="{Binding IsGravatarEmail, Converter={StaticResource BoolToVis}}"
                                                Margin="0,4,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                    Command="{Binding PreviewAvatarCommand}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Margin="0,0,14,0"
                                                    Cursor="Hand"
                                                    ToolTip="Просмотреть аватар">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="avatarBorder"
                                                                Width="48" Height="48"
                                                                CornerRadius="24"
                                                                Background="#1A00D2FF"
                                                                BorderBrush="#4D00D2FF"
                                                                BorderThickness="1.5"
                                                                ClipToBounds="True">
                                                            <Grid>
                                                                <ui:SymbolIcon Symbol="PersonCircle24" FontSize="26" Foreground="#00D2FF"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <Image Source="{Binding GravatarEmailData.AvatarUrl}"
                                                                       Stretch="UniformToFill"
                                                                       Width="48" Height="48"
                                                                       Visibility="{Binding GravatarEmailData.HasAvatar, Converter={StaticResource BoolToVis}}" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="avatarBorder" Property="BorderBrush" Value="#00D2FF" />
                                                                <Setter TargetName="avatarBorder" Property="Background" Value="#3300D2FF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GravatarEmailData.EffectiveName}"
                                                               FontSize="16"
                                                               FontWeight="Black"
                                                               Foreground="#F8FAFC"
                                                               VerticalAlignment="Center" />

                                                    <TextBlock Text="{Binding GravatarEmailData.FormattedUsername}"
                                                               FontSize="13"
                                                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                               Foreground="#00D2FF"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center" />

                                                    <!-- Copy Username Button -->
                                                    <Button Command="{Binding CopyValueCommand}"
                                                            CommandParameter="{Binding GravatarEmailData.Username}"
                                                            ToolTip="Скопировать никнейм"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="4,0"
                                                            Margin="6,0,0,0"
                                                            Cursor="Hand"
                                                            VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Copy24" FontSize="13" Foreground="#64748B" />
                                                    </Button>
                                                </StackPanel>

                                                <!-- Location & About Me -->
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                            Visibility="{Binding GravatarEmailData.HasLocation, Converter={StaticResource BoolToVis}}">
                                                    <ui:SymbolIcon Symbol="Location24" FontSize="11" Foreground="#64748B" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding GravatarEmailData.Location}"
                                                               FontSize="11"
                                                               Foreground="#94A3B8"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Text="{Binding GravatarEmailData.AboutMe}"
                                                           FontSize="11"
                                                           FontStyle="Italic"
                                                           Foreground="#CBD5E1"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding GravatarEmailData.HasAboutMe, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <!-- Open in Browser Button -->
                                            <Button Grid.Column="2"
                                                    Command="{Binding OpenUrlCommand}"
                                                    CommandParameter="{Binding GravatarEmailData.ProfileUrl}"
                                                    Style="{StaticResource CyberGhostButtonStyle}"
                                                    VerticalAlignment="Center"
                                                    Height="34"
                                                    Padding="12,0"
                                                    ToolTip="Открыть профиль Gravatar в браузере"
                                                    Visibility="{Binding GravatarEmailData.HasProfileUrl, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Open24" FontSize="13" Foreground="#00D2FF" Margin="0,0,6,0" />
                                                    <TextBlock Text="{DynamicResource Search_Card_Profile_Btn}" FontSize="11" FontWeight="Bold" Foreground="#00D2FF" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- 7. Disposable Email Detector Template -->
                                    <StackPanel Grid.Row="1"
                                                Visibility="{Binding IsDisposableEmail, Converter={StaticResource BoolToVis}}"
                                                Margin="0,4,0,4">
                                        <!-- Risk / Status Banner -->
                                        <Border Background="{Binding DisposableEmailData.StatusBadgeBackground}"
                                                BorderBrush="{Binding DisposableEmailData.StatusBadgeColor}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,10"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Warning Icon -->
                                                <Border Grid.Column="0"
                                                        Width="36" Height="36"
                                                        CornerRadius="18"
                                                        Background="{Binding DisposableEmailData.StatusBadgeBackground}"
                                                        BorderBrush="{Binding DisposableEmailData.StatusBadgeColor}"
                                                        BorderThickness="1"
                                                        Margin="0,0,12,0">
                                                    <ui:SymbolIcon Symbol="{Binding DisposableEmailData.StatusIconSymbol}" FontSize="18" Foreground="{Binding DisposableEmailData.StatusBadgeColor}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Text & Advice -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisposableEmailData.StatusWarningTitle}"
                                                               FontSize="13"
                                                               FontWeight="Black"
                                                               Foreground="{Binding DisposableEmailData.StatusBadgeColor}" />
                                                    <TextBlock Text="{Binding DisposableEmailData.StatusWarningMessage}"
                                                               FontSize="11"
                                                               Foreground="#E2E8F0"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <!-- Status Pill -->
                                                <Border Grid.Column="2"
                                                        Background="{Binding DisposableEmailData.StatusBadgeBackground}"
                                                        BorderBrush="{Binding DisposableEmailData.StatusBadgeColor}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10,4"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisposableEmailData.StatusBadgeText}"
                                                               FontFamily="JetBrains Mono"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding DisposableEmailData.StatusBadgeColor}" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Metadata Details -->
                                        <Border Background="#120D1524"
                                                BorderBrush="#1AFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource Search_Card_Disposable_Domain}" Foreground="#64748B" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding DisposableEmailData.Domain}"
                                                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                               FontWeight="Bold"
                                                               FontSize="12"
                                                               Foreground="#F8FAFC" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{DynamicResource Search_Card_Disposable_Category}" Foreground="#64748B" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding DisposableEmailData.Category}"
                                                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                               FontSize="12"
                                                               Foreground="#94A3B8" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{DynamicResource Search_Card_Disposable_TargetEmail}" Foreground="#64748B" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding DisposableEmailData.Email, TargetNullValue='—', FallbackValue='—'}"
                                                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                               FontSize="12"
                                                               Foreground="#94A3B8" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- 8. MX Server & Mail Provider Template -->
                                    <StackPanel Grid.Row="1"
                                                Visibility="{Binding IsMxEmail, Converter={StaticResource BoolToVis}}"
                                                Margin="0,4,0,4">
                                        <!-- Top Row: Provider Name & Badges -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Mail24" FontSize="16" Foreground="#FF7A00" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding MxEmailData.MailProviderName}"
                                                               FontSize="16"
                                                               FontWeight="Black"
                                                               Foreground="#F8FAFC"
                                                               VerticalAlignment="Center" />

                                                    <!-- Enterprise Pill -->
                                                    <Border Background="#2000D2FF"
                                                            BorderBrush="#4D00D2FF"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8,2"
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding MxEmailData.IsEnterprise, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="ENTERPRISE"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   FontFamily="JetBrains Mono"
                                                                   Foreground="#00D2FF" />
                                                    </Border>

                                                    <!-- SPF Protection Pill -->
                                                    <Border Background="{Binding MxEmailData.SpfBadgeBackground}"
                                                            BorderBrush="{Binding MxEmailData.SpfBadgeColor}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8,2"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding MxEmailData.SpfBadgeText}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   FontFamily="JetBrains Mono"
                                                                   Foreground="{Binding MxEmailData.SpfBadgeColor}" />
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="24,3,0,0">
                                                    <TextBlock Text="{DynamicResource Search_Card_Mx_Domain}" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding MxEmailData.EmailDomain}"
                                                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                               FontSize="11"
                                                               Foreground="#94A3B8" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- MX Server Gateways List -->
                                        <Border Background="#120D1524"
                                                BorderBrush="#1AFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                Visibility="{Binding MxEmailData.HasMxServers, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Search_Card_Mx_Gateways}" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6" />
                                                <ItemsControl ItemsSource="{Binding MxEmailData.MxServers}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1AFFFFFF"
                                                                    BorderBrush="#25FFFFFF"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    Padding="8,3"
                                                                    Margin="0,0,6,6">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <ui:SymbolIcon Symbol="Server24" FontSize="11" Foreground="#FF7A00" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding}"
                                                                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                                               FontSize="11"
                                                                               Foreground="#F1F5F9" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Visibility="{Binding IsIpGeo, Converter={StaticResource BoolToVis}}"
                                                Margin="0,4,0,4">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#2000D2FF"
                                                            BorderBrush="#4D00D2FF"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8,3"
                                                            Margin="0,0,10,4"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding IpGeoData.FlagEmoji}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding IpGeoData.FlagEmoji, Converter={StaticResource NotEmptyToVis}}" />
                                                            <TextBlock Text="{Binding IpGeoData.LocationBadgeText}" FontSize="12" FontWeight="Bold" FontFamily="JetBrains Mono, Segoe UI" Foreground="#00D2FF" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="#25A855F7"
                                                            BorderBrush="#A855F7"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="7,2"
                                                            Margin="0,0,8,4"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IpGeoData.IsHosting, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="DATACENTER / HOSTING" FontSize="10" FontWeight="Bold" FontFamily="JetBrains Mono" Foreground="#C084FC" />
                                                    </Border>

                                                    <Border Background="#25F43F5E"
                                                            BorderBrush="#F43F5E"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="7,2"
                                                            Margin="0,0,8,4"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IpGeoData.IsProxy, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="PROXY / VPN" FontSize="10" FontWeight="Bold" FontFamily="JetBrains Mono" Foreground="#FB7185" />
                                                    </Border>

                                                    <Border Background="#2500E599"
                                                            BorderBrush="#00E599"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="7,2"
                                                            Margin="0,0,8,4"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IpGeoData.IsMobile, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="MOBILE NETWORK" FontSize="10" FontWeight="Bold" FontFamily="JetBrains Mono" Foreground="#34D399" />
                                                    </Border>
                                                </WrapPanel>

                                                <WrapPanel Orientation="Horizontal" Margin="2,4,0,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,2" Visibility="{Binding IpGeoData.HasCoordinates, Converter={StaticResource BoolToVis}}">
                                                        <ui:SymbolIcon Symbol="Location24" FontSize="12" Foreground="#64748B" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding IpGeoData.Coordinates}" FontFamily="JetBrains Mono" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                                        <Button Command="{Binding CopyValueCommand}" CommandParameter="{Binding IpGeoData.Coordinates}"
                                                                Width="18" Height="18" Padding="0" Margin="4,0,0,0" VerticalAlignment="Center"
                                                                Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Скопировать координаты">
                                                            <ui:SymbolIcon Symbol="Copy24" FontSize="10" Foreground="#64748B" />
                                                        </Button>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,2" Visibility="{Binding IpGeoData.HasTimezone, Converter={StaticResource BoolToVis}}">
                                                        <ui:SymbolIcon Symbol="Clock24" FontSize="12" Foreground="#64748B" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding IpGeoData.Timezone}" FontFamily="JetBrains Mono" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
                                                        <ui:SymbolIcon Symbol="Server24" FontSize="12" Foreground="#64748B" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding IpGeoData.Ip}" FontFamily="JetBrains Mono" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                        <Button Command="{Binding CopyValueCommand}" CommandParameter="{Binding IpGeoData.Ip}"
                                                                Width="18" Height="18" Padding="0" Margin="4,0,0,0" VerticalAlignment="Center"
                                                                Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Скопировать IP адрес">
                                                            <ui:SymbolIcon Symbol="Copy24" FontSize="10" Foreground="#64748B" />
                                                        </Button>
                                                    </StackPanel>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>

                                        <Border Background="#120D1524"
                                                BorderBrush="#1AFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                Margin="0,4,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="AUTONOMOUS SYSTEM (ASN)" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Router24" FontSize="13" Foreground="#6366F1" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding IpGeoData.Asn, TargetNullValue='—', FallbackValue='—'}" FontFamily="JetBrains Mono" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="INTERNET SERVICE PROVIDER / ORG" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Globe24" FontSize="13" Foreground="#00D2FF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding IpGeoData.Isp, TargetNullValue='—', FallbackValue='—'}" FontFamily="JetBrains Mono" FontSize="12" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Visibility="{Binding IsIpReverseDns, Converter={StaticResource BoolToVis}}"
                                                Margin="0,4,0,4">
                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Foreground="#818CF8" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding IpReverseDnsData.ArpaQuery}" FontFamily="JetBrains Mono" FontSize="13" FontWeight="Bold" Foreground="#818CF8" VerticalAlignment="Center" />
                                            <Border Background="#20818CF8" BorderBrush="#4D818CF8" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="PTR" FontSize="10" FontWeight="Bold" FontFamily="JetBrains Mono" Foreground="#A5B4FC" />
                                            </Border>
                                            <Button Command="{Binding CopyValueCommand}" CommandParameter="{Binding IpReverseDnsData.ArpaQuery}"
                                                    Width="20" Height="20" Padding="0" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Скопировать ARPA запрос">
                                                <ui:SymbolIcon Symbol="Copy24" FontSize="11" Foreground="#64748B" />
                                            </Button>
                                        </WrapPanel>

                                        <Border Background="#120D1524"
                                                BorderBrush="#1AFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="RESOLVED HOSTNAMES (PTR)" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding IpReverseDnsData.HostnamesCount, StringFormat='({0})'}" FontSize="10" FontWeight="Bold" Foreground="#818CF8" />
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding IpReverseDnsData.Hostnames}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding PivotSearchCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Margin="0,0,8,6"
                                                                    Padding="0"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Cursor="Hand"
                                                                    ToolTip="Нажмите для запуска Pivot-поиска по этому хосту">
                                                                <Border Background="#1A818CF8" BorderBrush="#4D818CF8" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <ui:SymbolIcon Symbol="Globe24" FontSize="12" Foreground="#818CF8" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding}" FontFamily="JetBrains Mono" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                                                                        <ui:SymbolIcon Symbol="ArrowRight24" FontSize="10" Foreground="#818CF8" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Visibility="{Binding IsIpShodan, Converter={StaticResource BoolToVis}}"
                                                Margin="0,4,0,4">
                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Shield24" FontSize="16" Foreground="#FFB800" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="SHODAN INTERNETDB" FontSize="13" FontWeight="Black" Foreground="#F8FAFC" VerticalAlignment="Center" />

                                            <Border Background="#2500E599" BorderBrush="#4D00E599" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IpShodanData.HasVulns, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="12" Foreground="#00E599" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="NO KNOWN VULNERABILITIES" FontSize="10" FontWeight="Bold" FontFamily="JetBrains Mono" Foreground="#00E599" />
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#25F43F5E" BorderBrush="#F43F5E" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IpShodanData.HasVulns, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="ShieldError24" FontSize="12" Foreground="#F43F5E" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding IpShodanData.VulnsCount, StringFormat='CRITICAL CVE ({0})'}" FontSize="10" FontWeight="Bold" FontFamily="JetBrains Mono" Foreground="#F43F5E" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>

                                        <Border Background="#120D1524"
                                                BorderBrush="#1AFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                Margin="0,0,0,8"
                                                Visibility="{Binding IpShodanData.HasPorts, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="OPEN PORTS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding IpShodanData.PortsCount, StringFormat='({0})'}" FontSize="10" FontWeight="Bold" Foreground="#FFB800" />
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding IpShodanData.Ports}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#20FFB800" BorderBrush="#4DFFB800" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,6">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <ui:SymbolIcon Symbol="PlugDisconnected24" FontSize="11" Foreground="#FFB800" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding}" FontFamily="JetBrains Mono" FontSize="11" FontWeight="Bold" Foreground="#FEF08A" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#120D1524"
                                                BorderBrush="#1AFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                Margin="0,0,0,8"
                                                Visibility="{Binding IpShodanData.HasTags, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="SERVICE TAGS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6" />
                                                <ItemsControl ItemsSource="{Binding IpShodanData.Tags}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,6">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <ui:SymbolIcon Symbol="Tag24" FontSize="11" Foreground="#00D2FF" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding}" FontFamily="JetBrains Mono" FontSize="11" Foreground="#E0F2FE" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#1AF43F5E"
                                                BorderBrush="#4DF43F5E"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                Visibility="{Binding IpShodanData.HasVulns, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <ui:SymbolIcon Symbol="ShieldError24" FontSize="14" Foreground="#F43F5E" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="DETECTED CVE VULNERABILITIES" FontSize="10" FontWeight="Bold" Foreground="#F43F5E" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding IpShodanData.Vulnerabilities}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#25F43F5E" BorderBrush="#F43F5E" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,6">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding}" FontFamily="JetBrains Mono" FontSize="11" FontWeight="Bold" Foreground="#FECDD3" />
                                                                    <Button Command="{Binding PivotSearchCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            Width="16" Height="16" Padding="0" Margin="6,0,0,0"
                                                                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Скопировать / исследовать CVE">
                                                                        <ui:SymbolIcon Symbol="Copy24" FontSize="10" Foreground="#FDA4AF" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>


                                    <!-- USERNAME: GITHUB PROFILE CARD -->
                                    <StackPanel Grid.Row="1"
                                                Visibility="{Binding IsUsernameGithub, Converter={StaticResource BoolToVis}}"
                                                Margin="0,4,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar with Preview modal trigger -->
                                            <Button Grid.Column="0"
                                                    Command="{Binding PreviewAvatarCommand}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Margin="0,0,14,0"
                                                    Cursor="Hand"
                                                    ToolTip="Просмотреть аватар">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="avatarBorder"
                                                                Width="52" Height="52"
                                                                CornerRadius="26"
                                                                Background="#1A8957E5"
                                                                BorderBrush="#4D8957E5"
                                                                BorderThickness="1.5"
                                                                ClipToBounds="True">
                                                            <Grid>
                                                                <ui:SymbolIcon Symbol="PersonCircle24" FontSize="28" Foreground="#8957E5"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <Image Source="{Binding UsernameGithubData.AvatarUrl}"
                                                                       Stretch="UniformToFill"
                                                                       Width="52" Height="52"
                                                                       Visibility="{Binding UsernameGithubData.HasAvatar, Converter={StaticResource BoolToVis}}" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="avatarBorder" Property="BorderBrush" Value="#8957E5" />
                                                                <Setter TargetName="avatarBorder" Property="Background" Value="#338957E5" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Main Profile Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding UsernameGithubData.DisplayTitle}"
                                                               FontSize="16"
                                                               FontWeight="Black"
                                                               Foreground="#F0F6FC"
                                                               VerticalAlignment="Center" />
                                                    <Border Background="#258957E5"
                                                            BorderBrush="#8957E5"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="7,2"
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding UsernameGithubData.FormattedUsername}"
                                                                   FontFamily="JetBrains Mono, Segoe UI"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="#A855F7" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Bio -->
                                                <TextBlock Text="{Binding UsernameGithubData.Bio}"
                                                           FontSize="12"
                                                           Foreground="#94A3B8"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding UsernameGithubData.HasBio, Converter={StaticResource BoolToVis}}" />

                                                <!-- Chips / Badges Row: Location, Company, Email, Blog -->
                                                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                                            CornerRadius="6" Padding="8,3" Margin="0,0,8,4"
                                                            Visibility="{Binding UsernameGithubData.HasCompany, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Building24" FontSize="11" Foreground="#60A5FA" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding UsernameGithubData.Company}" FontSize="11" Foreground="#CBD5E1" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                                            CornerRadius="6" Padding="8,3" Margin="0,0,8,4"
                                                            Visibility="{Binding UsernameGithubData.HasLocation, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Location24" FontSize="11" Foreground="#38BDF8" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding UsernameGithubData.Location}" FontSize="11" Foreground="#CBD5E1" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                                            CornerRadius="6" Padding="8,3" Margin="0,0,8,4"
                                                            Visibility="{Binding UsernameGithubData.HasEmail, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Mail24" FontSize="11" Foreground="#F59E0B" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding UsernameGithubData.Email}" FontSize="11" FontFamily="JetBrains Mono" Foreground="#CBD5E1" />
                                                            <Button Command="{Binding PivotSearchCommand}"
                                                                    CommandParameter="{Binding UsernameGithubData.Email}"
                                                                    Width="16" Height="16" Padding="0" Margin="6,0,0,0"
                                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Исследовать Email">
                                                                <ui:SymbolIcon Symbol="ArrowRight24" FontSize="10" Foreground="#F59E0B" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                                            CornerRadius="6" Padding="8,3" Margin="0,0,8,4"
                                                            Visibility="{Binding UsernameGithubData.HasBlog, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Globe24" FontSize="11" Foreground="#00E599" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding UsernameGithubData.Blog}" FontSize="11" Foreground="#CBD5E1" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                                            CornerRadius="6" Padding="8,3" Margin="0,0,8,4"
                                                            Visibility="{Binding UsernameGithubData.HasTwitter, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="X / @" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,2,0" />
                                                            <TextBlock Text="{Binding UsernameGithubData.Twitter}" FontSize="11" Foreground="#CBD5E1" />
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Right Side: Stats (Repos & Followers) + Profile Button -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                                <Border Background="#120D1524" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <StackPanel Margin="0,0,12,0" HorizontalAlignment="Center">
                                                            <TextBlock Text="REPOS" FontSize="9" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" />
                                                            <TextBlock Text="{Binding UsernameGithubData.FormattedRepos}" FontSize="13" FontWeight="Black" FontFamily="JetBrains Mono" Foreground="#38BDF8" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                        <Rectangle Width="1" Fill="#20FFFFFF" Margin="0,2,12,2" />
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="FOLLOWERS" FontSize="9" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" />
                                                            <TextBlock Text="{Binding UsernameGithubData.FormattedFollowers}" FontSize="13" FontWeight="Black" FontFamily="JetBrains Mono" Foreground="#A855F7" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <Button Command="{Binding OpenUrlCommand}"
                                                        CommandParameter="{Binding UsernameGithubData.ProfileUrl}"
                                                        Style="{StaticResource CyberGhostButtonStyle}"
                                                        Height="34"
                                                        Padding="12,0"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Открыть GitHub профиль">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Open24" FontSize="13" Foreground="#A855F7" Margin="0,0,6,0" />
                                                        <TextBlock Text="GitHub" FontWeight="Bold" FontSize="11" Foreground="#A855F7" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- USERNAME: TELEGRAM PROFILE CARD -->
                                    <StackPanel Grid.Row="1"
                                                Visibility="{Binding IsUsernameTelegram, Converter={StaticResource BoolToVis}}"
                                                Margin="0,4,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Telegram Avatar -->
                                            <Button Grid.Column="0"
                                                    Command="{Binding PreviewAvatarCommand}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Margin="0,0,14,0"
                                                    Cursor="Hand"
                                                    ToolTip="Просмотреть аватар">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="avatarBorder"
                                                                Width="50" Height="50"
                                                                CornerRadius="25"
                                                                Background="#1A2AABEE"
                                                                BorderBrush="#4D2AABEE"
                                                                BorderThickness="1.5"
                                                                ClipToBounds="True">
                                                            <Grid>
                                                                <ui:SymbolIcon Symbol="Send24" FontSize="24" Foreground="#2AABEE"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <Image Source="{Binding UsernameTelegramData.AvatarUrl}"
                                                                       Stretch="UniformToFill"
                                                                       Width="50" Height="50"
                                                                       Visibility="{Binding UsernameTelegramData.HasAvatar, Converter={StaticResource BoolToVis}}" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="avatarBorder" Property="BorderBrush" Value="#2AABEE" />
