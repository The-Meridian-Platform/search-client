                                                    <TextBlock Text="{Binding DomainDmarcData.Domain}"
                                                               FontFamily="JetBrains Mono"
                                                               FontSize="12"
                                                               Foreground="#00D2FF"
                                                               FontWeight="SemiBold"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <!-- Spoofing Risk Chip -->
                                                <Border Grid.Column="2"
                                                        Background="#25FF3366"
