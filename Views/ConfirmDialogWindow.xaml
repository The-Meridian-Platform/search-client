<Window x:Class="MeridianClient.Views.ConfirmDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Подтверждение действия"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="440"
        SizeToContent="Height"
        ShowInTaskbar="False">

    <Border x:Name="mainContainerBorder"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="22"
            Margin="10"
            Opacity="0">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                <TranslateTransform Y="10" />
            </TransformGroup>
        </Border.RenderTransform>
        <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>

        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.20">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                         From="0.94" To="1.0" Duration="0:0:0.22">
                            <DoubleAnimation.EasingFunction>
                                <BackEase Amplitude="0.25" EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                         From="0.94" To="1.0" Duration="0:0:0.22">
                            <DoubleAnimation.EasingFunction>
                                <BackEase Amplitude="0.25" EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                         From="10" To="0" Duration="0:0:0.20">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.65" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto" />
                <!-- Content / Message -->
                <RowDefinition Height="Auto" />
                <!-- Footer / Buttons -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header (Icon, Title, Close) -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon Badge with Aura -->
                <Border x:Name="iconBadge"
                        Grid.Column="0"
                        Width="38" Height="38"
                        CornerRadius="10"
                        Background="#26FF3366"
                        BorderBrush="#66FF3366"
                        BorderThickness="1"
                        Margin="0,0,14,0">
                    <ui:SymbolIcon x:Name="dialogIcon"
                                   Symbol="Delete24"
                                   FontSize="18"
                                   Foreground="#FF3366"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>

                <!-- Dialog Title -->
                <TextBlock x:Name="txtTitle"
                           Grid.Column="1"
                           Text="Удаление расследования"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center" />

                <!-- Close Button -->
                <Button Grid.Column="2"
                        Click="BtnCancel_Click"
                        Width="30" Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Закрыть">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                </Button>
            </Grid>

            <!-- 2. Message Body -->
            <StackPanel Grid.Row="1" Margin="0,0,0,22">
                <TextBlock x:Name="txtMessage"
                           Text="Вы действительно хотите удалить это расследование?"
                           FontSize="13"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           TextWrapping="Wrap"
                           LineHeight="20" />

                <TextBlock x:Name="txtSubMessage"
                           Text="Все сохраненные связи и промежуточные сессии будут безвозвратно удалены."
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
            </StackPanel>

            <!-- 3. Bottom Action Buttons -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Cancel Button -->
                <Button Grid.Column="1"
                        x:Name="btnCancel"
                        Click="BtnCancel_Click"
                        IsCancel="True"
                        Height="38"
                        Padding="18,0"
                        Margin="0,0,10,0"
                        Cursor="Hand"
                        Background="{DynamicResource AppBackgroundBrush}"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock x:Name="txtCancelLabel" Text="Отмена" FontSize="12" FontWeight="SemiBold" />
                </Button>

                <!-- Confirm / Action Button -->
                <Button Grid.Column="2"
                        x:Name="btnConfirm"
                        Click="BtnConfirm_Click"
                        IsDefault="True"
                        Height="38"
                        Padding="22,0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b"
                                                Background="#E0FF3366"
                                                BorderBrush="#FF3366"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#FF3366" BlurRadius="14" ShadowDepth="0" Opacity="0.45" />
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#FFFF3366" />
                                                <Setter TargetName="b" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#FF3366" BlurRadius="20" ShadowDepth="0" Opacity="0.75" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock x:Name="txtConfirmLabel" Text="Удалить" FontSize="12" FontWeight="Bold" Foreground="White" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
