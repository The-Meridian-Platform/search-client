                                                                               Foreground="#F8FAFC"
                                                                               Margin="0,0,8,0" />
                                                                    <Button Command="{Binding DataContext.PivotSearchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Style="{StaticResource CyberGhostButtonStyle}"
                                                                            Height="22"
                                                                            Padding="6,0"
                                                                            ToolTip="Pivot поиск по извлеченной почте">
                                                                        <TextBlock Text="Pivot" FontSize="9" FontWeight="Bold" Foreground="#00E599" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Extracted Hostnames / Devices -->
                                                <ItemsControl ItemsSource="{Binding UsernameSshKeysData.DiscoveredHostnames}"
                                                              Visibility="{Binding UsernameSshKeysData.HasHostnames, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1A818CF8"
                                                                    BorderBrush="#4D818CF8"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    Padding="8,4"
                                                                    Margin="0,0,8,6">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <ui:SymbolIcon Symbol="Desktop24" FontSize="12" Foreground="#818CF8" Margin="0,0,6,0" />
                                                                    <TextBlock Text="{Binding}"
                                                                               FontFamily="JetBrains Mono"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#F8FAFC" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1"
                                                Margin="0,4,0,4">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDns}" Value="False" />
                                                            <Condition Binding="{Binding IsWhois}" Value="False" />
                                                            <Condition Binding="{Binding IsSubdomain}" Value="False" />
                                                            <Condition Binding="{Binding IsHttpTech}" Value="False" />
                                                            <Condition Binding="{Binding IsEmailFinding}" Value="False" />
                                                            <Condition Binding="{Binding IsUsernameFinding}" Value="False" />
                                                            <Condition Binding="{Binding IsIpFinding}" Value="False" />
                                                            <Condition Binding="{Binding IsDomainDmarc}" Value="False" />
                                                            <Condition Binding="{Binding IsDomainSecurityTxt}" Value="False" />
                                                            <Condition Binding="{Binding IsUsernameSshKeys}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,8">
                                            <TextBlock Text="{Binding RawJson}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="50"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                       FontSize="11" />
                                        </Border>
                                    </StackPanel>

                                    <!-- BOTTOM ROW: COLLAPSIBLE RAW JSON VIEWER (Obsidian Glass) -->
                                    <Border Grid.Row="2"
                                            Background="{DynamicResource AppBackgroundBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12"
                                            Margin="0,10,0,0"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Raw JSON Action Bar -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                                    <TextBlock Text="RAW PAYLOAD (JSON):"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               FontSize="10"
                                                               FontWeight="Bold" />
                                                </StackPanel>

                                                <Button HorizontalAlignment="Right"
                                                        Command="{Binding CopyJsonCommand}"
                                                        Padding="10,4"
                                                        FontSize="11"
                                                        Style="{StaticResource CyberGhostButtonStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Copy24" Margin="0,0,5,0" FontSize="13" Foreground="{DynamicResource AccentBrush}" />
                                                        <TextBlock Text="Скопировать" FontFamily="JetBrains Mono, Cascadia Code, Consolas" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <!-- Prettified JSON Text with Cyber Cyan Syntax Look -->
                                            <TextBox Grid.Row="1"
                                                     Text="{Binding FormattedJson, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"
                                                     MaxHeight="220"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{DynamicResource AccentBrush}"
                                                     FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                     FontSize="12" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
