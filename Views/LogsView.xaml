<UserControl x:Class="MeridianClient.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MeridianClient.ViewModels"
             xmlns:models="clr-namespace:MeridianClient.Models"
             xmlns:conv="clr-namespace:MeridianClient.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:LogsViewModel}"
             d:DesignHeight="720" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
        <conv:StringEqualsToBooleanConverter x:Key="StringEqualsToBool" />

        <!-- Neon cyber filter chip style -->
        <Style x:Key="LogFilterChipStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="LogLevelFilterGroup" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="chipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Ghost Action Button -->
        <Style x:Key="LogActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RenderTransform>
            <TranslateTransform Y="0" />
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.25">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.25">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <!-- Header Banner -->
            <RowDefinition Height="Auto" />
            <!-- Filter & Action Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Log Entries List -->
            <RowDefinition Height="*" />
            <!-- Footer Status -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. HEADER BANNER -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18,14"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Subtitle -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="{DynamicResource Logs_Title}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <Border Margin="10,0,0,0"
                                Background="{DynamicResource SubtleAccentBrush}"
                                BorderBrush="{DynamicResource BorderAccentBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,2">
                            <TextBlock Text="LIVE STREAM"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Logs_Subtitle}"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>

                <!-- Right: Neon Metric Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Total Count -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ВСЕГО: " FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding TotalCount}" FontSize="12" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Info Count -->
                    <Border Background="{DynamicResource SubtleAccentBrush}" BorderBrush="{DynamicResource BorderAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ИНФО: " FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding InfoCount}" FontSize="12" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Warning Count -->
                    <Border Background="#1AFFB800" BorderBrush="#33FFB800" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ВАРН: " FontSize="10" FontWeight="Bold" Foreground="#FFB800" />
                            <TextBlock Text="{Binding WarningCount}" FontSize="12" FontWeight="Black" Foreground="#FFB800" />
                        </StackPanel>
                    </Border>

                    <!-- Error Count -->
                    <Border Background="#20FF3366" BorderBrush="#40FF3366" BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ОШИБКИ: " FontSize="10" FontWeight="Bold" Foreground="#FF3366" />
                            <TextBlock Text="{Binding ErrorCount}" FontSize="12" FontWeight="Black" Foreground="#FF3366" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. FILTER & TOOLBAR -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Search Input -->
                    <ColumnDefinition Width="260" />
                    <!-- Level Filter Chips with Toggle Button -->
                    <ColumnDefinition Width="*" />
                    <!-- Action Buttons -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Input Box -->
                <Border Grid.Column="0"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,4"
                        Height="36"
                        Margin="0,0,14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Search24" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="2,0,8,0" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 CaretBrush="{DynamicResource AccentBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="Фильтр по тексту, коду, URL..."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Opacity="0.5"
                                   FontSize="12"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding FilterText, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilterText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Level Filters with Toggle Button (+) / (X) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Toggle Filter Button (+) / (X) matching SearchView -->
                    <ToggleButton x:Name="btnToggleLogFilters"
                                  IsChecked="{Binding IsFiltersPanelOpen, Mode=TwoWay}"
                                  Cursor="Hand"
                                  ToolTip="Показать / скрыть фильтры уровней логов"
                                  Margin="0,0,10,0">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="toggleBorder"
                                        Width="36" Height="36"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <ui:SymbolIcon x:Name="plusIcon"
                                                       Symbol="Add24"
                                                       FontSize="18"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       RenderTransformOrigin="0.5,0.5">
                                            <ui:SymbolIcon.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </ui:SymbolIcon.RenderTransform>
                                        </ui:SymbolIcon>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="toggleBorder" Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
                                        <Setter TargetName="toggleBorder" Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}" />
                                        <Setter TargetName="plusIcon" Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="toggleBorder" Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
                                        <Setter TargetName="toggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="plusIcon" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="plusIcon"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     To="45" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="plusIcon"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     To="0" Duration="0:0:0.22">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseIn" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <!-- Filter Chips Panel -->
                    <Border ClipToBounds="True" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="-25" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFiltersPanelOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.0" To="1.0" Duration="0:0:0.28">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     From="-25" To="0" Duration="0:0:0.28">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0.0" Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseIn" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     To="-25" Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseIn" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Content="{DynamicResource Logs_Level_All}"
                                         IsChecked="{Binding SelectedLevel, Converter={StaticResource StringEqualsToBool}, ConverterParameter=All, Mode=OneWay}"
                                         Style="{StaticResource LogFilterChipStyle}"
                                         Command="{Binding SetLevelFilterCommand}"
                                         CommandParameter="All" />
                            <RadioButton Content="{DynamicResource Logs_Level_Info}"
                                         IsChecked="{Binding SelectedLevel, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Info, Mode=OneWay}"
                                         Style="{StaticResource LogFilterChipStyle}"
                                         Command="{Binding SetLevelFilterCommand}"
                                         CommandParameter="Info" />
                            <RadioButton Content="{DynamicResource Logs_Level_Warning}"
                                         IsChecked="{Binding SelectedLevel, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Warning, Mode=OneWay}"
                                         Style="{StaticResource LogFilterChipStyle}"
                                         Command="{Binding SetLevelFilterCommand}"
                                         CommandParameter="Warning" />
                            <RadioButton Content="{DynamicResource Logs_Level_Error}"
                                         IsChecked="{Binding SelectedLevel, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Error, Mode=OneWay}"
                                         Style="{StaticResource LogFilterChipStyle}"
                                         Command="{Binding SetLevelFilterCommand}"
                                         CommandParameter="Error" />
                            <RadioButton Content="{DynamicResource Logs_Level_Debug}"
                                         IsChecked="{Binding SelectedLevel, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Debug, Mode=OneWay}"
                                         Style="{StaticResource LogFilterChipStyle}"
                                         Command="{Binding SetLevelFilterCommand}"
                                         CommandParameter="Debug" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Auto-scroll checkbox -->
                    <CheckBox IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Logs_AutoScroll}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </CheckBox>

                    <!-- Copy All Button -->
                    <Button Command="{Binding CopyAllLogsCommand}"
                            Style="{StaticResource LogActionButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="Скопировать все отфильтрованные логи">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Copy24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{DynamicResource Logs_CopyAll}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Clear Button -->
                    <Button Command="{Binding ClearLogsCommand}"
                            Style="{StaticResource LogActionButtonStyle}"
                            ToolTip="Очистить текущий журнал логов">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0" Foreground="#FF3366" />
                            <TextBlock Text="{DynamicResource Logs_Clear}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. LOG ENTRIES LIST -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="6">
            <Grid>
                <!-- Empty State Placeholder -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding FilteredLogs.Count, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredLogs.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Style>
                    </StackPanel.Style>
                    <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="42" Foreground="#334155" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="Журнал логов чист"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#475569"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="События REST API, gRPC и Health Check появятся здесь при выполнении операций."
                               FontSize="11"
                               Foreground="#334155"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Scrollable Log Items -->
                <ScrollViewer x:Name="LogsScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FilteredLogs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:LogEntry}">
                                <Border Margin="4,3,4,3"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.RenderTransform>
                                        <TranslateTransform Y="0" />
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="6" To="0" Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Accent indicator -->
                                            <ColumnDefinition Width="3" />
                                            <!-- Entry body -->
                                            <ColumnDefinition Width="*" />
                                            <!-- Copy entry button -->
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Accent vertical strip -->
                                        <Border Grid.Column="0"
                                                Background="{Binding LevelColor}"
                                                CornerRadius="2"
                                                Margin="0,2,8,2" />

                                        <!-- Body -->
                                        <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                            <!-- Header line: Timestamp, Level Badge, Source Badge -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <!-- Timestamp -->
                                                <TextBlock Text="{Binding TimestampDisplay}"
                                                           FontFamily="Consolas, JetBrains Mono, Cascadia Code"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0" />

                                                <!-- Level Pill -->
                                                <Border Background="{Binding LevelBackground}"
                                                        BorderBrush="{Binding LevelColor}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,1"
                                                        Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding LevelBadgeText}"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding LevelColor}"
                                                               FontFamily="Consolas, JetBrains Mono" />
                                                </Border>

                                                <!-- Source Pill -->
                                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,1">
                                                    <TextBlock Text="{Binding Source}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               FontFamily="Consolas, JetBrains Mono" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Message Text -->
                                            <TextBlock Text="{Binding Message}"
                                                       FontFamily="Consolas, JetBrains Mono, Cascadia Code"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextWrapping="Wrap" />

                                            <!-- Expandable / Collapsible Details block (if any) -->
                                            <Border Margin="0,6,0,0"
                                                    Background="{DynamicResource CardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,8"
                                                    Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="DETAILS &amp; STACKTRACE:"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="#475569"
                                                               Margin="0,0,0,4" />
                                                    <TextBox Text="{Binding Details, Mode=OneWay}"
                                                             FontFamily="Consolas, JetBrains Mono, Cascadia Code"
                                                             FontSize="10"
                                                             Foreground="{DynamicResource SecondaryTextBrush}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             IsReadOnly="True"
                                                             TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Copy Single Log Button -->
                                        <Button Grid.Column="2"
                                                VerticalAlignment="Top"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4"
                                                Cursor="Hand"
                                                ToolTip="Скопировать эту запись"
                                                Command="{Binding DataContext.CopyLogEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Copy24" FontSize="13" Foreground="#475569" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 4. FOOTER STATUS BAR -->
        <Border Grid.Row="3" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Notification -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusNotification}"
                           FontSize="11"
                           Foreground="{DynamicResource AccentBrush}"
                           FontFamily="Consolas, JetBrains Mono"
                           VerticalAlignment="Center" />

                <!-- Filter indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Уровень: " FontSize="10" Foreground="#64748B" />
                    <TextBlock Text="{Binding SelectedLevel}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="Отображено: " FontSize="10" Foreground="#64748B" />
                    <TextBlock Text="{Binding FilteredLogs.Count}" FontSize="10" FontWeight="Bold" Foreground="#F8FAFC" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
